{
  "name": "thiepn-library",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate": "pnpm check && pnpm validate:content",
    "build:astro": "astro build",
    "index": "pagefind --site dist/library",
    "build": "pnpm validate && pnpm build:astro && pnpm index",
    "l17b:verify": "tsx scripts/l17b-verify.ts",
    "certify:source": "node scripts/certification/source.mjs",
    "certify:postbuild": "node scripts/certification/post-build.mjs",
    "release:certify": "pnpm certify:source && pnpm l17b:verify && pnpm build && pnpm certify:postbuild",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^6.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "pagefind": "^1.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.32.0"
  }
}
