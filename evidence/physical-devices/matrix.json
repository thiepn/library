{
  "schemaVersion": 1,
  "phaseId": "RR2",
  "name": "Physical-Device Acceptance and Evidence",
  "maximumEvidenceAgeDays": 90,
  "minimumSessionMinutes": 30,
  "evidencePolicy": {
    "minimumItemsForPassingRecord": 1,
    "permittedReferences": [
      "https URL",
      "repository-relative path"
    ],
    "forbiddenContent": [
      "private personal-book pages",
      "credentials",
      "secrets",
      "unredacted personal information"
    ]
  },
  "journeys": [
    {
      "id": "catalog-navigation",
      "label": "Catalog and Library navigation",
      "description": "Open the catalog, book details, My Library, and return without overflow, blocked controls, or dead navigation."
    },
    {
      "id": "hosted-epub-start-resume",
      "label": "Hosted EPUB start and resume",
      "description": "Open a hosted EPUB, move away from the initial position, close the reader, and resume the exact release without a dead or shifted reader."
    },
    {
      "id": "epub-layout-appearance",
      "label": "EPUB layout and appearance",
      "description": "Switch pagination/scrolling, spread, typography, width, margin, and theme while keeping controls reachable and position stable."
    },
    {
      "id": "epub-tools",
      "label": "EPUB search, bookmarks, highlights, and notes",
      "description": "Use in-book search, create and reopen a bookmark, create a highlight/note, and dismiss every panel correctly."
    },
    {
      "id": "hosted-pdf-start-resume",
      "label": "Hosted PDF start and resume",
      "description": "Open a hosted PDF, navigate pages, close, and resume the same exact-release page state."
    },
    {
      "id": "pdf-tools",
      "label": "PDF search, bookmarks, fit, and zoom",
      "description": "Use search and page bookmarks, switch fit modes, adjust zoom, and verify focus/dialog ownership."
    },
    {
      "id": "personal-import-reopen",
      "label": "Personal EPUB and PDF import",
      "description": "Import one valid EPUB and PDF, open both canonical readers, leave, and reopen them from My Library."
    },
    {
      "id": "viewport-adaptation",
      "label": "Resize, rotation, safe areas, and split view",
      "description": "Exercise every target-required viewport variant without hidden controls, covered content, or horizontal document overflow."
    },
    {
      "id": "software-keyboard",
      "label": "Software keyboard behavior",
      "description": "Focus reader inputs, verify the keyboard does not cover the active control, dismiss it, and recover full reader space."
    },
    {
      "id": "keyboard-dialogs",
      "label": "Keyboard and dialog ownership",
      "description": "Operate core reader actions without a pointer, dismiss overlays with Escape, and verify deterministic focus restoration."
    },
    {
      "id": "native-selection",
      "label": "Native text selection",
      "description": "Select publication text using the platform selection model without accidental page turns or an unusable action toolbar."
    },
    {
      "id": "browser-history",
      "label": "Browser and OS navigation",
      "description": "Use Back, Forward, reader exit, and route re-entry without a dead reader, duplicate history, or lost position."
    },
    {
      "id": "background-resume",
      "label": "Background, lock, and resume",
      "description": "Background the browser or PWA, lock the device where applicable, return, and continue without reload loops or lost state."
    },
    {
      "id": "offline-pwa",
      "label": "Installed PWA and offline recovery",
      "description": "Install or launch the PWA, explicitly cache supported content, go offline, reopen it, and recover cleanly when content is unavailable."
    },
    {
      "id": "sustained-session",
      "label": "Sustained reading session",
      "description": "Read continuously for the configured minimum duration while page turns, scrolling, panels, memory behavior, and device temperature remain usable."
    }
  ],
