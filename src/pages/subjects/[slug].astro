---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getWorks, type ResolvedWork } from '../../lib/content/repository';
import { getTaxonomyItems, taxonomyLabel } from '../../lib/content/taxonomy';
export async function getStaticPaths() {
  const works = await getWorks();
  return getTaxonomyItems(works, 'subjects').map((subject) => ({ params: { slug: subject.slug }, props: { subject: subject.slug, works: works.filter((work) => work.classification.subjects.includes(subject.slug)) } }));
}
interface Props { subject: string; works: ResolvedWork[]; }
const { subject, works } = Astro.props;
---
<BaseLayout title={taxonomyLabel(subject)} description={`Library publications about ${taxonomyLabel(subject)}.`}>
  <div class="page"><section class="section">
    <div class="section-heading"><div><p class="eyebrow">Subject</p><h1>{taxonomyLabel(subject)}</h1></div><p class="micro">{works.length} publication{works.length === 1 ? '' : 's'}</p></div>
    <div class="work-list">{works.map((work, index) => <WorkCard work={work} index={index + 1} />)}</div>
  </section></div>
</BaseLayout>
