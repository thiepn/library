---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F3EE" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>Offline — Thiepn Library</title>
    <style is:inline>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; background: #f5f3ee; color: #1d1d1b; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; box-sizing: border-box; }
      main { width: min(560px, 100%); border: 1px solid currentColor; padding: clamp(24px, 6vw, 48px); background: Canvas; }
      p { line-height: 1.6; }
      a { color: inherit; font-weight: 700; }
      @media (prefers-color-scheme: dark) { :root { background: #111; color: #f4f1e8; } }
    </style>
  </head>
  <body>
    <main>
      <p><strong>Thiepn Library</strong></p>
      <h1>You’re offline.</h1>
      <p>This page is not available from the local Library cache yet. Pages you have already visited and immutable EPUB editions prepared by the reader may still be available offline.</p>
      <p><a href={`${base}/`}>Return to the Library</a></p>
    </main>
  </body>
</html>
