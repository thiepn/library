---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" description="About Thiepn Library, a personal digital library and ebook reader.">
  <div class="page">
    <section class="section">
      <div class="section-heading">
        <div><p class="eyebrow">About</p><h1>About the Library</h1></div>
      </div>
      <div class="empty">
        <p>Thiepn Library is a personal digital library for reading books in the browser, EPUB, and PDF. Reading progress, saved books, bookmarks, highlights, notes, and reader preferences are stored locally in your browser, and the Library can be prepared for offline reading without requiring an account.</p>
      </div>
    </section>
  </div>
</BaseLayout>
