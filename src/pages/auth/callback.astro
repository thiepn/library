---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Connecting THIEPN Account"
  description="Completing the THIEPN Account connection for Thiepn Library."
  noindex
>
  <div class="page">
    <section class="section" aria-labelledby="sso-callback-title">
      <h1 id="sso-callback-title">Connecting THIEPN Account…</h1>
      <p data-sso-callback-status>Verifying the secure sign-in response.</p>
      <p><a data-sso-retry href="/library/account/">Return to Account and reconnect</a></p>
      <p><a data-sso-guest href="/library/">Continue reading without an account</a></p>
    </section>
  </div>

  <script>
    import {
      completeLibraryAccountSsoCallback,
      consumeLibraryAccountSsoReturnTo,
    } from '../../lib/account/supabase';

    const status = document.querySelector<HTMLElement>('[data-sso-callback-status]');
    void completeLibraryAccountSsoCallback()
      .then((user) => {
        if (!user) {
          if (status) status.textContent = 'THIEPN Account authorization was not completed. You can continue reading as a guest.';
          window.history.replaceState(null, '', window.location.pathname);
          return;
        }
        window.location.replace(consumeLibraryAccountSsoReturnTo());
      })
      .catch((error: unknown) => {
        // Only display stable error codes. OAuth query parameters, bearer
        // tokens, and PKCE verifiers must never appear in error messages.
        const code = error instanceof Error && /^ACCOUNT_[A-Z0-9_]+$/.test(error.message)
          ? error.message : 'ACCOUNT_CALLBACK_UNAVAILABLE';
        if (status) {
          status.textContent = 'THIEPN Account authorization could not be verified (' + code + '). You can continue reading as a guest.';
        }
        // Do not retain one-use OAuth code/state in the visible failed URL.
        window.history.replaceState(null, '', window.location.pathname);
      });
  </script>
</BaseLayout>
