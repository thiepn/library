---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWorks } from '../lib/content/repository';
import '../styles/notebook.css';
import '../styles/notebook-n1h.css';
import '../styles/notebook-n1i.css';
import '../styles/notebook-n1j.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catalog = (await getWorks()).map((work) => ({
  id: work.id, title: work.title, slug: work.slug,
  hasPdf: Boolean(work.release?.artifacts.pdf),
}));
---
<BaseLayout title="Book Notebook" description="Private, local-first book overviews, chapter summaries and reading notes." noindex>
  <div class="page book-notebook" data-notebook-root data-base={base}>
    <section class="section">
      <header class="book-notebook__header">
        <div>
          <p class="eyebrow">Your reading knowledge</p>
          <h1>Book Notebook</h1>
          <p class="micro">Write, connect, organize, and reread your ideas across books. All notebook content stays local.</p>
        </div>
        <a class="secondary-action" href={`${base}/knowledge`}>All knowledge</a>
      </header>
      <p class="book-notebook__warning" role="note">N1C: Notebook documents are included in Library V2 JSON backups and per-book Markdown export. Private Account synchronization is paused until the V2 server downgrade guard is independently enabled. Keep a manual backup. <a href={`${base}/backup`}>Open Backup &amp; restore</a>.</p>
      <section class="book-notebook__dashboard" aria-labelledby="notebook-dashboard-heading">
        <div class="book-notebook__dashboard-heading">
          <div>
            <p class="eyebrow">Your notebook</p>
            <h2 id="notebook-dashboard-heading">Ideas at a glance</h2>
          </div>
          <a href={`${base}/backup`}>Back up notebook</a>
        </div>
        <div class="book-notebook__dashboard-stats" data-notebook-dashboard-stats aria-label="Notebook statistics">
          <div><strong data-dashboard-stat="notes">0</strong><span>Notes</span></div>
          <div><strong data-dashboard-stat="books">0</strong><span>Books</span></div>
          <div><strong data-dashboard-stat="connections">0</strong><span>Connections</span></div>
          <div><strong data-dashboard-stat="topics">0</strong><span>Topics</span></div>
        </div>
        <div class="book-notebook__dashboard-grid">
          <section aria-labelledby="dashboard-recent-heading">
            <h3 id="dashboard-recent-heading">Continue writing</h3>
            <div class="book-notebook__dashboard-recent" data-dashboard-recent>
              <p class="micro">Your recently edited notes will appear here.</p>
            </div>
          </section>
          <section aria-labelledby="dashboard-topics-heading">
            <h3 id="dashboard-topics-heading">Browse topics</h3>
            <div class="book-notebook__topic-cloud" data-dashboard-topics>
              <p class="micro">Add a topic in a note to organize ideas across books.</p>
            </div>
            <p class="micro" data-dashboard-unlinked></p>
          </section>
        </div>
      </section>
      <section class="book-notebook__graph-workspace" aria-labelledby="notebook-graph-heading">
        <div class="book-notebook__graph-header">
          <div>
            <p class="eyebrow">Explore ideas</p>
            <h2 id="notebook-graph-heading">Note relationships</h2>
            <p class="micro">Solid lines are links you wrote. Dashed lines represent shared topic markers, not inferred facts.</p>
          </div>
          <button type="button" data-graph-expand aria-expanded="false" aria-controls="notebook-graph-panel">Explore graph</button>
        </div>
        <div id="notebook-graph-panel" data-graph-panel hidden>
          <div class="book-notebook__graph-controls">
            <label><input type="checkbox" data-graph-topic-edges /> Show shared-topic connections</label>
            <label for="notebook-graph-zoom">Zoom</label>
            <input id="notebook-graph-zoom" type="range" min="75" max="175" value="100" step="5" data-graph-zoom />
            <button type="button" data-graph-reset>Show all</button>
          </div>
          <div class="book-notebook__graph-layout">
            <svg data-graph-canvas class="book-notebook__graph-canvas" viewBox="0 0 960 600"
              role="img" aria-label="Interactive graph of connected notebook notes"></svg>
            <aside class="book-notebook__graph-details" aria-live="polite">
              <h3 data-graph-selected-title>Choose a note</h3>
              <p data-graph-selected-book class="micro">Select a circle or a note below to explore links.</p>
              <p data-graph-selected-stats class="micro"></p>
              <div data-graph-neighbors class="book-notebook__graph-neighbors"></div>
              <div class="book-notebook__graph-actions">
                <button type="button" data-graph-preview disabled>Preview note</button>
                <button type="button" data-graph-open disabled>Open in editor</button>
              </div>
            </aside>
          </div>
          <p class="micro" role="status" data-graph-status></p>
          <div class="book-notebook__graph-accessible" data-graph-accessible
            aria-label="Notes in the relationship graph"></div>
        </div>
      </section>
      <div class="book-notebook__selector">
        <label for="notebook-book">Book</label>
        <select id="notebook-book" data-notebook-book>
          <option value="">Select a book…</option>
        </select>
        <a data-notebook-read href={`${base}/saved`} hidden>Read book</a>
        <button type="button" class="secondary-action" data-notebook-export disabled>Export book as Markdown</button>
      </div>
      <section class="book-notebook__discover" aria-labelledby="notebook-discover-heading">
        <div class="book-notebook__discover-head">
          <div>
            <h2 id="notebook-discover-heading">Explore across books</h2>
            <p class="micro">Find connections in every notebook saved on this device.</p>
          </div>
          <p class="micro" data-discover-count role="status" aria-live="polite"></p>
        </div>
        <div class="book-notebook__discover-filters">
          <label for="notebook-discover-query">Search all notes</label>
          <input id="notebook-discover-query" type="search" autocomplete="off"
            placeholder="A theme, author, chapter, or phrase" data-discover-query />
          <label for="notebook-discover-book">From book</label>
          <select id="notebook-discover-book" data-discover-book>
            <option value="all">All books</option>
          </select>
          <label for="notebook-discover-topic">Topic</label>
          <select id="notebook-discover-topic" data-discover-topic>
            <option value="all">All topics</option>
          </select>
        </div>
        <div class="book-notebook__saved-views" aria-label="Saved notebook workspaces">
          <div class="book-notebook__saved-views-heading">
            <h3>Saved views</h3>
            <p class="micro">Local to this browser. They do not change your notebook data or Account sync.</p>
          </div>
          <div class="book-notebook__saved-views-controls">
            <label for="notebook-saved-view">Open view</label>
            <select id="notebook-saved-view" data-saved-view><option value="">Current filters</option></select>
            <button type="button" data-view-apply>Apply</button>
            <button type="button" data-view-delete>Remove view</button>
            <label for="notebook-view-name">Save as</label>
            <input id="notebook-view-name" data-view-name maxlength="64" placeholder="e.g. Connected philosophy notes" />
            <button type="button" data-view-save>Save these filters</button>
            <button type="button" data-view-clear>Clear filters</button>
          </div>
          <p class="micro" role="status" aria-live="polite" data-view-status></p>
        </div>
        <div class="book-notebook__advanced-filters">
          <label for="notebook-discover-scope">Type</label>
          <select id="notebook-discover-scope" data-discover-scope>
            <option value="all">Every note type</option>
            <option value="reading-note">Reading notes</option>
            <option value="chapter-summary">Chapter summaries</option>
            <option value="book-overview">Book overview</option>
          </select>
          <label for="notebook-discover-links">Connections</label>
          <select id="notebook-discover-links" data-discover-links>
            <option value="all">All notes</option>
            <option value="connected">With links</option>
            <option value="unconnected">Without links</option>
          </select>
          <label for="notebook-discover-sort">Sort</label>
          <select id="notebook-discover-sort" data-discover-sort>
            <option value="recent">Recently edited</option>
            <option value="oldest">Oldest first</option>
            <option value="title">Title A–Z</option>
          </select>
        </div>
        <div class="book-notebook__discover-results" data-discover-results></div>
        <p class="micro" data-discover-empty hidden>No matching notebook notes.</p>
      </section>
      <section class="book-notebook__research" data-research-root aria-labelledby="notebook-research-title">
        <header class="book-notebook__research-head">
          <div>
            <p class="eyebrow">Study workbench</p>
            <h2 id="notebook-research-title">Research collections</h2>
            <p class="micro">Group existing notes across books, compare sources, and write a native Library synthesis.</p>
          </div>
          <div class="book-notebook__research-count" data-research-summary>Local-only collections</div>
        </header>
        <div class="book-notebook__research-toolbar">
          <label for="research-collection">Open collection</label>
          <select id="research-collection" data-research-select><option value="">Choose a collection…</option></select>
          <button type="button" data-research-export-index>Export collection index</button>
          <button type="button" data-research-import-index>Import index</button>
          <input type="file" accept=".json,application/json" data-research-index-file hidden />
        </div>
        <div class="book-notebook__research-create">
          <label for="research-new-name">New collection</label>
          <input id="research-new-name" maxlength="100" data-research-new-name placeholder="e.g. Discipleship in four books" />
          <label for="research-new-workflow">Workflow</label>
          <select id="research-new-workflow" data-research-new-workflow>
            <option value="open-research">Open research</option>
            <option value="compare-authors">Compare authors</option>
            <option value="argument-review">Evaluate an argument</option>
            <option value="discussion-prep">Discussion preparation</option>
          </select>
          <label for="research-new-description">Purpose</label>
          <input id="research-new-description" maxlength="800" data-research-new-description
            placeholder="Question or project goal (optional)" />
          <button type="button" data-research-create>Create collection</button>
        </div>
        <p class="micro" role="status" aria-live="polite" data-research-status></p>
        <div data-research-detail hidden>
          <div class="book-notebook__research-details">
            <div>
              <h3 data-research-name></h3>
              <p data-research-description class="micro"></p>
            </div>
            <div class="book-notebook__research-collection-actions">
              <button type="button" data-research-export-markdown>Export grouped Markdown</button>
              <button type="button" data-research-delete>Remove collection</button>
            </div>
          </div>
          <div class="book-notebook__research-pick">
            <label for="research-find-note">Add existing notes</label>
            <input id="research-find-note" data-research-find type="search"
              placeholder="Search titles, books, text and topics" autocomplete="off" />
            <div data-research-search-results class="book-notebook__research-search-results"></div>
          </div>
          <div class="book-notebook__research-sources">
            <h4>Collected source notes</h4>
            <p class="micro">Pin any two notes for a side-by-side comparison. Unavailable notes keep their original IDs.</p>
            <div data-research-sources class="book-notebook__research-sources-list"></div>
          </div>
          <div class="book-notebook__research-compare" aria-label="Side-by-side source reading">
            <article>
              <header><h4>Source A</h4><span data-research-left-caption class="micro">Select a source</span></header>
              <div data-research-left-preview class="book-notebook__research-preview"></div>
              <div data-research-left-actions class="book-notebook__research-reader-actions"></div>
            </article>
            <article>
              <header><h4>Source B</h4><span data-research-right-caption class="micro">Select a source</span></header>
              <div data-research-right-preview class="book-notebook__research-preview"></div>
              <div data-research-right-actions class="book-notebook__research-reader-actions"></div>
            </article>
          </div>
          <div class="book-notebook__research-write">
            <div class="book-notebook__research-write-head">
              <div>
                <h4>Research synthesis</h4>
                <p class="micro">Stored as an ordinary revision-controlled notebook note, not an unsynced collection memo.</p>
              </div>
              <span data-research-synthesis-state class="micro">No synthesis created</span>
            </div>
            <button type="button" data-research-make-synthesis>Create synthesis note from sources</button>
            <label for="research-synthesis-title">Synthesis title</label>
            <input id="research-synthesis-title" data-research-synthesis-title maxlength="200" disabled />
            <label for="research-synthesis-body">Synthesis Markdown</label>
            <textarea id="research-synthesis-body" data-research-synthesis-body
              maxlength="250000" rows="12" disabled></textarea>
            <div class="book-notebook__research-write-actions">
              <button type="button" data-research-save-synthesis disabled>Save synthesis</button>
              <button type="button" data-research-open-synthesis disabled>Open in notebook editor</button>
              <button type="button" data-research-reload-synthesis disabled>Reload saved version</button>
            </div>
          </div>
        </div>
        <p class="micro">Collections and saved views remain on this browser; export the collection index separately when moving devices. Notebook notes and synthesis remain in the existing V2 Library backup.</p>
      </section>
      <p class="micro" data-notebook-count aria-live="polite"></p>
      <div class="book-notebook__toolbar" aria-label="Create notebook content">
        <button type="button" data-notebook-create="book-overview" disabled>Book overview</button>
        <button type="button" data-notebook-create="chapter-summary" disabled>Chapter summary</button>
        <button type="button" data-notebook-create="reading-note" disabled>Quick reading note</button>
      </div>
      <div class="book-notebook__chapter" data-notebook-chapter hidden>
        <label for="notebook-chapter-key">Chapter ID, heading, or PDF page</label>
        <input id="notebook-chapter-key" data-notebook-chapter-key maxlength="240" placeholder="e.g. Chapter 3 or Page 42" />
        <button type="button" data-notebook-chapter-confirm>Create summary</button>
        <button type="button" class="secondary-action" data-notebook-chapter-cancel>Cancel</button>
      </div>
      <p class="micro" role="status" aria-live="polite" data-notebook-status>Select a book to begin.</p>
      <div class="book-notebook__layout">
        <aside class="book-notebook__sidebar" aria-label="Book notes">
          <h2>Notes</h2>
          <div class="book-notebook__filters">
            <label for="notebook-search">Find in notes</label>
            <input id="notebook-search" type="search" data-notebook-search placeholder="Title, chapter, or note text" autocomplete="off" disabled />
            <label for="notebook-scope">Show</label>
            <select id="notebook-scope" data-notebook-scope disabled>
              <option value="all">All notes</option>
              <option value="reading-note">Reading notes</option>
              <option value="chapter-summary">Chapter summaries</option>
              <option value="book-overview">Book overview</option>
            </select>
            <label for="notebook-sort">Order</label>
            <select id="notebook-sort" data-notebook-sort disabled>
              <option value="recent">Recently edited</option>
              <option value="oldest">Oldest first</option>
              <option value="title">Title A–Z</option>
            </select>
            <p class="micro" role="status" aria-live="polite" data-notebook-matches></p>
          </div>
          <div data-notebook-list></div>
          <p class="micro" data-notebook-empty>No notes yet. Create a book overview or quick reading note.</p>
          <a data-notebook-highlights href={`${base}/knowledge`} hidden>View this book’s highlights and bookmarks in Knowledge</a>
        </aside>
        <section class="book-notebook__editor" data-notebook-editor hidden aria-label="Markdown note editor">
          <div class="book-notebook__editor-top">
            <span data-notebook-kind></span>
            <span class="micro" data-notebook-save-status aria-live="polite">Not saved</span>
            <button type="button" class="secondary-action" data-notebook-add-research>Add to research</button>
          </div>
          <div class="book-notebook__history" role="navigation" aria-label="Navigate recently opened notes">
            <button type="button" data-note-history-back disabled>← Previous note</button>
            <span class="micro" data-note-history-position>Open a saved note to navigate.</span>
            <button type="button" data-note-history-forward disabled>Next note →</button>
          </div>
          <label for="notebook-title">Title</label>
          <input id="notebook-title" data-notebook-title maxlength="200" autocomplete="off" />
          <label for="notebook-body">Markdown note</label>
          <div class="book-notebook__template-tools">
            <label for="notebook-template">Writing template</label>
            <select id="notebook-template" data-notebook-template>
              <option value="">Choose a template…</option>
            </select>
            <button type="button" data-notebook-insert-template>Insert template</button>
            <p class="micro">Inserts headings at your cursor. It never replaces the entire note.</p>
          </div>
          <div class="book-notebook__writing-bar" role="toolbar" aria-label="Markdown writing tools">
            <button type="button" data-markdown-tool="bold" title="Bold (Ctrl+B)" aria-label="Bold selection"><strong>B</strong></button>
            <button type="button" data-markdown-tool="italic" title="Italic (Ctrl+I)" aria-label="Italic selection"><em>I</em></button>
            <button type="button" data-markdown-tool="heading" title="Heading" aria-label="Insert heading">H2</button>
            <button type="button" data-markdown-tool="bullet" title="Bullet list" aria-label="Insert bullet list">• List</button>
            <button type="button" data-markdown-tool="number" title="Numbered list" aria-label="Insert numbered list">1. List</button>
            <button type="button" data-markdown-tool="quote" title="Block quote" aria-label="Insert quote">Quote</button>
            <button type="button" data-markdown-tool="checkbox" title="Task list" aria-label="Insert task list">Task</button>
            <button type="button" data-markdown-tool="code" title="Inline code" aria-label="Inline code">Code</button>
            <button type="button" data-notebook-add-link aria-expanded="false" aria-controls="notebook-link-picker">Link note</button>
            <button type="button" data-notebook-insert-table>Table</button>
            <button type="button" data-notebook-insert-divider>Divider</button>
          </div>
          <div class="book-notebook__link-picker" id="notebook-link-picker" data-notebook-link-picker hidden>
            <label for="notebook-link-search">Link to a note from any book</label>
            <input type="search" id="notebook-link-search" data-notebook-link-search
              placeholder="Search notes to link…" autocomplete="off" />
            <div class="book-notebook__link-results" data-notebook-link-results></div>
            <button type="button" data-notebook-link-close>Close link picker</button>
          </div>
          <div class="book-notebook__view-toolbar" role="group" aria-label="Reading and writing view">
            <button type="button" data-notebook-view="write" aria-pressed="true">Write</button>
            <button type="button" data-notebook-view="split" aria-pressed="false">Split</button>
            <button type="button" data-notebook-view="read" aria-pressed="false">Read</button>
          </div>
          <div class="book-notebook__writing-surface" data-notebook-writing-surface>
            <textarea id="notebook-body" data-notebook-body maxlength="250000" spellcheck="true" placeholder="Write a thought, summary, question, or reflection…"></textarea>
            <article class="book-notebook__reading-preview" data-notebook-reading-preview
              aria-label="Markdown reading preview" hidden></article>
          </div>
          <section class="book-notebook__outline" aria-labelledby="notebook-outline-heading">
            <div class="book-notebook__outline-header">
              <h3 id="notebook-outline-heading">Note outline</h3>
              <span class="micro" data-outline-count>No headings</span>
            </div>
            <nav data-notebook-outline aria-label="Jump to Markdown headings"></nav>
          </section>
          <div class="book-notebook__writing-meta">
            <span data-notebook-words aria-live="polite">0 words</span>
            <span data-notebook-characters>0 characters</span>
            <button type="button" data-notebook-focus aria-pressed="false">Focus writing</button>
          </div>
          <div class="book-notebook__topics-editor">
            <div>
              <label for="notebook-topic-input">Organize by topic</label>
              <p class="micro">Topics are plain Markdown markers (#topic/name), visible in exports and readable in other editors.</p>
            </div>
            <div class="book-notebook__topic-add">
              <input id="notebook-topic-input" data-notebook-topic-input
                maxlength="64" placeholder="e.g. discipleship" autocomplete="off" />
              <button type="button" data-notebook-topic-add>Add topic</button>
            </div>
            <div data-notebook-current-topics class="book-notebook__topic-cloud"></div>
            <details class="book-notebook__topic-manager">
              <summary>Manage topics across books</summary>
              <p class="micro">Rename or remove a topic from saved notes. A complete local JSON backup is downloaded before changes, and edits stop if another tab changed a note.</p>
              <div class="book-notebook__topic-manage-row">
                <label for="notebook-topic-manage-select">Existing topic</label>
                <select id="notebook-topic-manage-select" data-topic-manage-select><option value="">Choose topic…</option></select>
                <label for="notebook-topic-manage-name">New name</label>
                <input id="notebook-topic-manage-name" data-topic-manage-name maxlength="64" placeholder="Rename to…" />
                <button type="button" data-topic-rename>Rename across books</button>
                <button type="button" data-topic-remove>Remove topic</button>
              </div>
              <p class="micro" role="status" data-topic-manage-status></p>
            </details>
          </div>
          <div class="book-notebook__editor-actions">
            <button type="button" data-notebook-save>Save now</button>
            <button type="button" class="secondary-action" data-notebook-copy>Copy Markdown</button>
            <button type="button" class="secondary-action" data-notebook-recover>Download editor draft</button>
            <button type="button" class="secondary-action" data-notebook-close>Close</button>
            <button type="button" class="text-action" data-notebook-delete hidden>Delete note</button>
          </div>
          <p class="micro">Plain Markdown stays editable and portable. Use [[note:ID|Title]] to link saved notes by stable ID.</p>
          <section class="book-notebook__relations" aria-labelledby="notebook-relations-heading">
            <h3 id="notebook-relations-heading">Connected notes</h3>
            <div class="book-notebook__relation-columns">
              <div><h4>References in this note</h4><div data-notebook-outgoing></div></div>
              <div><h4>Notes linking here</h4><div data-notebook-backlinks></div></div>
            </div>
            <div class="book-notebook__suggested">
              <h4>Possible connections</h4>
              <p class="micro">Based on words shared across your own notes, not AI-generated conclusions.</p>
              <div data-notebook-suggestions></div>
            </div>
            <p class="micro" data-notebook-source></p>
            <div class="book-notebook__source-actions">
              <a data-notebook-source-reader hidden>Open original book</a>
              <button type="button" data-notebook-source-copy>Copy source reference</button>
            </div>
          </section>
        </section>
        <section class="book-notebook__welcome" data-notebook-welcome>
          <h2>Start with a thought</h2>
          <p>Keep a book overview, one summary per chapter, or as many free-form reading notes as you need. No folders or tags are required.</p>
        </section>
      </div>
    </section>
  </div>
  <dialog class="book-notebook__peek" data-notebook-linked-preview aria-labelledby="notebook-peek-title">
    <div class="book-notebook__linked-preview-head">
      <h2 id="notebook-peek-title" data-linked-preview-title>Linked note</h2>
      <button type="button" data-linked-preview-close aria-label="Close linked note preview">Close</button>
    </div>
    <p class="micro" data-linked-preview-source></p>
    <div class="book-notebook__linked-preview-text" data-linked-preview-text></div>
    <div class="book-notebook__peek-actions">
      <button type="button" data-linked-preview-open>Open this note</button>
      <button type="button" data-linked-preview-copy>Copy note reference</button>
    </div>
  </dialog>
  <div hidden data-notebook-catalog={JSON.stringify(catalog)}></div>
  <script>
    import {
      getPersonalBooks, personalReaderWorkId, type PersonalBookSummary,
    } from '../lib/client/personal-books';
    import {
      createBookNote, deleteBookNote, listBookNotes, getBookNote, subscribeBookNotes,
      updateBookNote, type NewBookNote,
    } from '../lib/knowledge/note-store';
    import { bookNotebookToObsidianMarkdown } from '../lib/knowledge/note-export';
    import { downloadNotebookRecovery } from '../lib/knowledge/note-recovery';
    import { renderNotebookPreview } from '../lib/knowledge/note-preview';
    import { mountResearchWorkbench } from '../lib/knowledge/note-research-dom';
    import { buildNoteGraph, graphNeighbors, type NoteGraphData } from '../lib/knowledge/note-graph';
    import { getNotebookHeadings, rewriteNotebookTopic } from '../lib/knowledge/note-outline';
    import {
