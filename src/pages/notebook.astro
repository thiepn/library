      const backlinks = root.querySelector<HTMLElement>('[data-notebook-backlinks]')!;
      const suggestions = root.querySelector<HTMLElement>('[data-notebook-suggestions]')!;
      const sourceInfo = root.querySelector<HTMLElement>('[data-notebook-source]')!;
      const sourceReader = root.querySelector<HTMLAnchorElement>('[data-notebook-source-reader]')!;
      const sourceCopy = root.querySelector<HTMLButtonElement>('[data-notebook-source-copy]')!;
      const wordCount = root.querySelector<HTMLElement>('[data-notebook-words]')!;
      const characterCount = root.querySelector<HTMLElement>('[data-notebook-characters]')!;
      const focusToggle = root.querySelector<HTMLButtonElement>('[data-notebook-focus]')!;
      const readingPreview = root.querySelector<HTMLElement>('[data-notebook-reading-preview]')!;
      const writingSurface = root.querySelector<HTMLElement>('[data-notebook-writing-surface]')!;
      const templateSelect = root.querySelector<HTMLSelectElement>('[data-notebook-template]')!;
      const topicInput = root.querySelector<HTMLInputElement>('[data-notebook-topic-input]')!;
      const currentTopics = root.querySelector<HTMLElement>('[data-notebook-current-topics]')!;
      const linkedPreview = document.querySelector<HTMLDialogElement>('[data-notebook-linked-preview]')!;
      const linkedPreviewTitle = root.querySelector<HTMLElement>('[data-linked-preview-title]')!;
      const linkedPreviewSource = root.querySelector<HTMLElement>('[data-linked-preview-source]')!;
      const linkedPreviewText = root.querySelector<HTMLElement>('[data-linked-preview-text]')!;
      const linkedPreviewOpen = linkedPreview.querySelector<HTMLButtonElement>('[data-linked-preview-open]')!;
      const linkedPreviewCopy = linkedPreview.querySelector<HTMLButtonElement>('[data-linked-preview-copy]')!;
      const linkedPreviewClose = linkedPreview.querySelector<HTMLButtonElement>('[data-linked-preview-close]')!;
      let peekOpener: HTMLElement | null = null;
      const dashboardRecent = root.querySelector<HTMLElement>('[data-dashboard-recent]')!;
      const dashboardTopics = root.querySelector<HTMLElement>('[data-dashboard-topics]')!;
      const dashboardUnlinked = root.querySelector<HTMLElement>('[data-dashboard-unlinked]')!;
      const dashboardStats = root.querySelector<HTMLElement>('[data-notebook-dashboard-stats]')!;
      const books = new Map<string, BookEntry>();
      const allNotes: BookNoteDocumentV1[] = [];
      let libraryNotes: BookNoteDocumentV1[] = [];
      let networkRequest = 0;
      let selected: BookNoteDocumentV1 | undefined;
      let draft: NewBookNote | undefined;
      let savedTitle = '';
      let savedBody = '';
      let saveTimer: ReturnType<typeof setTimeout> | undefined;
      let saving = false;
      let loadNumber = 0;
      let deletionArmed = false;
      let previewMode: 'write' | 'split' | 'read' = 'write';
      let linkedPreviewNote: BookNoteDocumentV1 | undefined;
      let graphFocus: string | undefined;
      let graphModel: NoteGraphData = { nodes: [], edges: [], omitted: 0, workCount: 0 };
      let topicMutationBusy = false;
      let currentViewId = '';
      const openedNoteHistory: string[] = [];
      let historyPosition = -1;
      let replayingHistory = false;
      const historyBack = root.querySelector<HTMLButtonElement>('[data-note-history-back]')!;
      const historyForward = root.querySelector<HTMLButtonElement>('[data-note-history-forward]')!;
      const historyLabel = root.querySelector<HTMLElement>('[data-note-history-position]')!;
      for (const template of NOTEBOOK_TEMPLATES)
        templateSelect.add(new Option(template.label + ' — ' + template.description, template.id));

      function dirty(): boolean {
        return Boolean(draft || selected) && (title.value !== savedTitle || body.value !== savedBody);
      }
      function mark(message: string): void { saveStatus.textContent = message; }
      function setStatus(message: string): void { status.textContent = message; }
      function currentBook(): string { return bookSelect.value; }
      function bookName(id: string): string { return books.get(id)?.title ?? id; }
      function linkLabel(note: BookNoteDocumentV1): string {
        return notebookTitle(note) + ' · ' + bookName(note.workId);
      }
      function paragraph(container: HTMLElement, message: string): void {
        const p = document.createElement('p'); p.className = 'micro'; p.textContent = message;
        container.append(p);
      }


      function updateNoteHistory(): void {
        historyBack.disabled = historyPosition <= 0;
        historyForward.disabled = historyPosition < 0
          || historyPosition >= openedNoteHistory.length - 1;
        historyLabel.textContent = historyPosition < 0
          ? 'Open a saved note to navigate.'
          : 'Opened notes: ' + (historyPosition+1) + ' / ' + openedNoteHistory.length
            + ' · Alt+← / Alt+→';
      }

      function recordNoteHistory(doc: BookNoteDocumentV1 | undefined): void {
        if (!doc || replayingHistory) return;
        if (openedNoteHistory[historyPosition] === doc.id) return;
        openedNoteHistory.splice(historyPosition+1);
        openedNoteHistory.push(doc.id);
        if(openedNoteHistory.length>40)openedNoteHistory.shift();
        historyPosition=openedNoteHistory.length-1;
        updateNoteHistory();
      }

      async function moveNoteHistory(direction: -1 | 1): Promise<void> {
        const destination=historyPosition+direction;
        if(destination<0 || destination>=openedNoteHistory.length)return;
        const id=openedNoteHistory[destination];
        const note=libraryNotes.find(item=>item.id===id) ?? await getBookNote(id);
        if(!note){setStatus('That note is no longer available on this device.');return;}
        replayingHistory=true;
        try {
          await openAnyNote(note);
          if(selected?.id===id){
            historyPosition=destination;
            updateNoteHistory();
          }
        } finally { replayingHistory=false; }
      }

      function download(name: string, content: string): void {
        const url = URL.createObjectURL(new Blob([content], { type: 'text/markdown;charset=utf-8' }));
        const a = document.createElement('a'); a.href = url; a.download = name; a.click();
        setTimeout(() => URL.revokeObjectURL(url), 0);
      }

      function updateBookControls(): void {
        const id = currentBook();
        for (const btn of root!.querySelectorAll<HTMLButtonElement>('[data-notebook-create]')) btn.disabled = !id;
        exportButton.disabled = !id;
        search.disabled = !id;
        scopeFilter.disabled = !id;
        sortBy.disabled = !id;
        highlightsLink.hidden = !id;
        highlightsLink.href = `${base}/knowledge?book=${encodeURIComponent(id)}`;
        const entry = books.get(id);
        readLink.hidden = !(entry?.personal || entry?.slug);
        if (entry?.personal) {
          const route = entry.personal.format === 'pdf' ? 'pdf' : 'read';
          readLink.href = `${base}/personal/${route}?id=${encodeURIComponent(entry.personal.id)}`;
        } else if (entry?.slug) readLink.href = `${base}/works/${encodeURIComponent(entry.slug)}/read`;
      }

      function hideEditor(): void {
        editor.hidden = true; welcome.hidden = false;
        selected = undefined; draft = undefined; savedTitle = ''; savedBody = '';
        removeButton.hidden = true; deletionArmed = false; removeButton.textContent = 'Delete note';
        const url = new URL(location.href);
        if (url.searchParams.has('note')) {
          url.searchParams.delete('note');
          history.replaceState(null, '', url);
        }
        linkPicker.hidden = true; linkToggle.setAttribute('aria-expanded', 'false');
        editor.classList.remove('book-notebook__editor--focus');
        focusToggle.setAttribute('aria-pressed', 'false');
        outline.replaceChildren();
        outlineCount.textContent='No note open';
      }

      function openEditor(doc?: BookNoteDocumentV1, pending?: NewBookNote): void {
        if (saveTimer) clearTimeout(saveTimer);
        selected = doc;
        draft = pending;
        savedTitle = doc?.title ?? pending?.title ?? '';
        savedBody = doc?.bodyMarkdown ?? '';
        title.value = doc?.title ?? pending?.title ?? '';
        body.value = doc?.bodyMarkdown ?? '';
        kindLabel.textContent = (doc?.scope ?? pending?.scope ?? 'reading-note').replace(/-/g, ' ');
        mark(doc ? 'Saved locally' : 'Draft — not yet saved');
        editor.hidden = false; welcome.hidden = true;
        removeButton.hidden = !doc;
        deletionArmed = false; removeButton.textContent = 'Delete note';
        const url = new URL(location.href);
        if (doc) {
          url.searchParams.set('work', doc.workId);
          url.searchParams.set('note', doc.id);
        } else {
          url.searchParams.delete('note');
        }
        history.replaceState(null, '', url);
        recordNoteHistory(doc);
        updateWritingStats();
        setWritingView(previewMode);
        renderOutline();
        renderConnections();
        renderNotes(allNotes);
        title.focus();
      }

      async function save(): Promise<boolean> {
        if (saving) return false;
        if (!selected && !draft) return true;
        if (!dirty()) return true;
        if (!title.value.trim() && !body.value.trim()) { mark('Empty draft — not saved'); return true; }
        const writeTitle = title.value;
        const writeBody = body.value;
        if (saveTimer) clearTimeout(saveTimer);
        saving = true; mark('Saving…');
        try {
          const next = selected
            ? await updateBookNote(selected.id, selected.revision, { title: writeTitle, bodyMarkdown: writeBody })
            : await createBookNote({ ...draft!, title: writeTitle, bodyMarkdown: writeBody });
          selected = next; draft = undefined;
          savedTitle = writeTitle; savedBody = writeBody;
          removeButton.hidden = false;
          mark('Saved locally');
          const url = new URL(location.href);
          url.searchParams.set('work', next.workId);
          url.searchParams.set('note', next.id);
          history.replaceState(null, '', url);
          void refresh();
          void refreshNetwork();
          if (dirty()) scheduleSave();
          return true;
        } catch (error) {
          mark(error instanceof Error ? error.message : 'Save failed. Copy your note to keep it safe.');
          return false;
        } finally { saving = false; }
      }
      function scheduleSave(): void {
        if (saveTimer) clearTimeout(saveTimer);
        mark('Unsaved changes');
        saveTimer = setTimeout(() => { void save(); }, 650);
      }
      async function switchEditor(doc?: BookNoteDocumentV1, pending?: NewBookNote): Promise<void> {
        if (dirty() && !await save()) { setStatus('Save failed. Copy your current text before changing notes.'); return; }
        openEditor(doc, pending);
      }

      function renderNotes(notes: BookNoteDocumentV1[]): void {
        const needle = search.value.normalize('NFKC').trim().toLocaleLowerCase();
        const selectedScope = scopeFilter.value;
        const visible = notes.filter((note) => {
          if (selectedScope !== 'all' && note.scope !== selectedScope) return false;
          if (!needle) return true;
          return [note.title, note.bodyMarkdown, note.chapterKey ?? '', note.anchor?.format ?? '']
            .some((text) => text.normalize('NFKC').toLocaleLowerCase().includes(needle));
        });
        const sorted = [...visible].sort((a, b) => {
          if (sortBy.value === 'title') return notebookTitle(a).localeCompare(notebookTitle(b));
          if (sortBy.value === 'oldest') return a.createdAt.localeCompare(b.createdAt);
          return b.updatedAt.localeCompare(a.updatedAt);
        });
        list.replaceChildren();
        const groups: Array<{ label: string; scope: BookNoteScope }> = [
          { label: 'Book overview', scope: 'book-overview' },
          { label: 'Chapter summaries', scope: 'chapter-summary' },
          { label: 'Reading notes', scope: 'reading-note' },
        ];
        for (const group of groups) {
          const relevant = sorted.filter((note) => note.scope === group.scope);
          if (!relevant.length) continue;
          const section = document.createElement('section');
          const heading = document.createElement('h3'); heading.textContent = group.label; section.append(heading);
          for (const note of relevant) {
            const link = document.createElement('button'); link.type = 'button'; link.className = 'book-notebook__item';
            const name = document.createElement('span'); name.textContent = notebookTitle(note);
            const modified = document.createElement('span');
            modified.className = 'book-notebook__item-date';
            modified.textContent = new Date(note.updatedAt).toLocaleDateString();
            link.append(name, modified);
            link.setAttribute('aria-label', 'Edit ' + notebookTitle(note));
            link.setAttribute('aria-current', String(note.id === selected?.id));
            link.addEventListener('click', () => { void switchEditor(note); });
            section.append(link);
          }
          list.append(section);
        }
        empty.textContent = notes.length ? 'No notes match these filters.' : 'No notes yet. Create a book overview or quick reading note.';
        empty.hidden = visible.length > 0;
        matches.textContent = visible.length === notes.length ? '' : visible.length + ' of ' + notes.length + ' notes shown';
        count.textContent = notes.length + (notes.length === 1 ? ' notebook note' : ' notebook notes');
      }


      function updateWritingStats(): void {
        const words = notebookWordCount(body.value);
        wordCount.textContent = words + (words === 1 ? ' word' : ' words');
        characterCount.textContent = body.value.length.toLocaleString() + ' characters';
      }

      async function openAnyNote(note: BookNoteDocumentV1): Promise<void> {
        if (dirty() && !await save()) {
          setStatus('Save failed. Download your draft before following another note.');
          return;
        }
        if (currentBook() !== note.workId) await chooseBook(note.workId);
        if (currentBook() !== note.workId) return;
        const current = libraryNotes.find(item => item.id === note.id) ?? note;
        openEditor(current);
        document.querySelector<HTMLElement>('[data-notebook-editor]')?.scrollIntoView({
          behavior: 'smooth', block: 'nearest',
        });
      }

      function connectedButton(note: BookNoteDocumentV1, description?: string): HTMLButtonElement {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'book-notebook__connection';
        const titleLine = document.createElement('strong');
        titleLine.textContent = notebookTitle(note);
        const subtitle = document.createElement('span');
        subtitle.textContent = description ?? bookName(note.workId);
        button.append(titleLine, subtitle);
        button.addEventListener('click', () => { void openAnyNote(note); });
        return button;
      }


      function renderReadingView(): void {
        if (previewMode === 'write' || editor.hidden) return;
        renderNotebookPreview(readingPreview, body.value, {
          notes: libraryNotes,
          onOpenNote: note => { void openAnyNote(note); },
        });
      }

      function setWritingView(mode: 'write' | 'split' | 'read'): void {
        previewMode = mode;
        writingSurface.dataset.view = mode;
        body.hidden = mode === 'read';
        readingPreview.hidden = mode === 'write';
        root!.querySelectorAll<HTMLButtonElement>('[data-notebook-view]').forEach(button => {
          button.setAttribute('aria-pressed', String(button.dataset.notebookView === mode));
        });
        renderReadingView();
        if (mode === 'write') body.focus({ preventScroll: true });
      }

      function insertAtCursor(markdown: string): void {
        if (!selected && !draft) { setStatus('Open a note before inserting content.'); return; }
        const insert = insertNotebookText(body.value, body.selectionStart, body.selectionEnd, markdown);
        if (insert.value.length > body.maxLength) {
          mark('Insertion would exceed the maximum note size.');
          return;
        }
        setWritingView('write');
        body.value = insert.value;
        body.setSelectionRange(insert.cursor, insert.cursor);
        body.dispatchEvent(new Event('input', { bubbles: true }));
      }

      function renderCurrentTopics(): void {
        currentTopics.replaceChildren();
        if (!selected && !draft) return;
        const topics = extractNotebookTopics(body.value);
        if (!topics.length) { paragraph(currentTopics, 'No topics in this note yet.'); return; }
        for (const id of topics) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'book-notebook__topic-chip';
          button.textContent = '#' + id;
          button.title = 'Browse this topic across saved books';
          button.addEventListener('click', () => selectTopic(id));
          currentTopics.append(button);
        }
      }

      function selectTopic(topic: string): void {
        if (![...discoverTopic.options].some(option => option.value === topic)) {
          setStatus('Save this topic before filtering across books.');
          return;
        }
        discoverBook.value = 'all';
        discoverTopic.value = topic;
        discoverQuery.value = '';
        currentViewId = '';
        savedView.value = '';
        renderDiscover();
        renderGraph();
        discoverQuery.closest('.book-notebook__discover')?.scrollIntoView({
          behavior: 'smooth', block: 'start',
        });
      }


      function currentWorkspaceFilters(): NotebookViewFilters {
        return {
          query: discoverQuery.value,
          workId: discoverBook.value,
          topic: discoverTopic.value,
          scope: discoverScope.value as NotebookViewFilters['scope'],
          sort: discoverSort.value as NotebookViewFilters['sort'],
          mode: discoverLinks.value as NotebookViewFilters['mode'],
        };
      }

      function workspaceNotes(): BookNoteDocumentV1[] {
        const filters = currentWorkspaceFilters();
        const joined = notebookViewConnectionIds(
          libraryNotes, note => extractNotebookLinks(note.bodyMarkdown).map(link => link.id));
        const filtered = libraryNotes.filter(note =>
          (filters.workId === 'all' || filters.workId === note.workId)
          && (filters.topic === 'all' || extractNotebookTopics(note.bodyMarkdown).includes(filters.topic))
          && (filters.scope === 'all' || note.scope === filters.scope)
          && (filters.mode === 'all' || (filters.mode === 'connected') === joined.has(note.id)));
        const searched = findNotebookNotes(filtered, bookName, filters.query, 200);
        if (filters.sort === 'title')
          return searched.sort((a,b) => notebookTitle(a).localeCompare(notebookTitle(b)));
        if (filters.sort === 'oldest')
          return searched.sort((a,b) => a.createdAt.localeCompare(b.createdAt));
        return searched.sort((a,b) => b.updatedAt.localeCompare(a.updatedAt));
      }

      function renderSavedViews(): void {
        const previous = savedView.value || currentViewId;
        savedView.replaceChildren(new Option('Current filters', ''));
        for (const view of readSavedNotebookViews())
          savedView.add(new Option(view.name, view.id));
        savedView.value = [...savedView.options].some(option => option.value === previous)
          ? previous : '';
        currentViewId = savedView.value;
      }

      function showGraphNode(id: string): void {
        const node = graphModel.nodes.find(entry => entry.id === id);
        const doc = libraryNotes.find(note => note.id === id);
        if (!node || !doc) return;
        graphFocus = id;
        graphSelectedTitle.textContent = notebookTitle(doc);
        graphSelectedBook.textContent = bookName(doc.workId);
        graphSelectedStats.textContent = node.incoming + ' incoming · ' + node.outgoing
          + ' outgoing references · ' + node.topics.length + ' topics';
        graphNeighborsList.replaceChildren();
        const adjacent = graphNeighbors(graphModel, id);
        for (const other of graphModel.nodes.filter(n => n.id !== id && adjacent.has(n.id)).slice(0,20)) {
          const button = document.createElement('button');
          button.type = 'button'; button.textContent = other.title;
          button.addEventListener('click', () => { showGraphNode(other.id); renderGraph(); });
          graphNeighborsList.append(button);
        }
        if (adjacent.size < 2) paragraph(graphNeighborsList, 'No visible neighbors. Try the shared-topic option.');
        graphOpenButton.disabled = false;
        graphPreviewButton.disabled = false;
      }

      function renderGraph(): void {
        if (graphPanel.hidden) return;
        const options = {
          limit: 70, includeSharedTopics: graphEdges.checked,
          ...(graphFocus ? {focus:graphFocus}:{}),
        };
        graphModel = buildNoteGraph(workspaceNotes(), options);
        if (graphFocus && !graphModel.nodes.some(node => node.id === graphFocus))graphFocus = undefined;
        graphCanvas.replaceChildren();
        graphAccessible.replaceChildren();
        const zoom = Math.max(.75,Math.min(1.75, Number(graphZoom.value)/100));
        graphCanvas.setAttribute('viewBox', [
          480-480/zoom,300-300/zoom,960/zoom,600/zoom,
        ].join(' '));
        const ns = 'http://www.w3.org/2000/svg';
        const nodeById = new Map(graphModel.nodes.map(node => [node.id,node]));
        const near = graphFocus ? graphNeighbors(graphModel,graphFocus) : null;
        for(const edge of graphModel.edges) {
          const source = nodeById.get(edge.source),target = nodeById.get(edge.target);
          if(!source || !target)continue;
          const line=document.createElementNS(ns,'line');
          line.setAttribute('x1',String(source.x));
          line.setAttribute('y1',String(source.y));
          line.setAttribute('x2',String(target.x));
          line.setAttribute('y2',String(target.y));
          line.setAttribute('class',edge.kind === 'reference'
            ? 'notebook-graph__reference' : 'notebook-graph__topic');
          if (near && !near.has(edge.source) && !near.has(edge.target))
            line.setAttribute('opacity','.2');
          graphCanvas.append(line);
        }
        for(const node of graphModel.nodes) {
          const group=document.createElementNS(ns,'g');
          group.setAttribute('class','notebook-graph__node' +
            (graphFocus===node.id?' is-selected':'') +
            (near && !near.has(node.id)?' is-muted':''));
          group.setAttribute('role','button');
          group.setAttribute('tabindex','0');
          group.setAttribute('aria-label','Select '+node.title+' from '+bookName(node.workId));
          group.setAttribute('transform','translate('+node.x+' '+node.y+')');
          const circle=document.createElementNS(ns,'circle');
          circle.setAttribute('r',graphFocus===node.id?'20':'16');
          const title=document.createElementNS(ns,'title');
          title.textContent=node.title+' — '+bookName(node.workId);
          const label=document.createElementNS(ns,'text');
          label.setAttribute('y','-25');
          label.setAttribute('text-anchor','middle');
          label.textContent=node.title.length>19?node.title.slice(0,18)+'…':node.title;
          group.append(title,circle,label);
          const select=()=>{showGraphNode(node.id);renderGraph();};
          group.addEventListener('click',select);
          group.addEventListener('keydown',e=>{
            if(e.key==='Enter' || e.key===' '){e.preventDefault();select();}
          });
          graphCanvas.append(group);
          const button=document.createElement('button');
          button.type='button';button.textContent=node.title+' — '+bookName(node.workId);
          button.addEventListener('click',()=>{showGraphNode(node.id);renderGraph();});
          graphAccessible.append(button);
        }
        graphStatus.textContent=graphModel.nodes.length+' notes · '+graphModel.edges.length
          +' visible connections'+(graphModel.omitted?' · '+graphModel.omitted+' hidden by graph limit':'');
        if(graphFocus)showGraphNode(graphFocus);
        else {
          graphSelectedTitle.textContent='Choose a note';
          graphSelectedBook.textContent='Select a circle or a note in the list.';
          graphSelectedStats.textContent='';
          graphNeighborsList.replaceChildren();
          graphOpenButton.disabled=true;graphPreviewButton.disabled=true;
        }
      }

      function renderOutline(): void {
        const headings=getNotebookHeadings(body.value);
        outline.replaceChildren();
        outlineCount.textContent=headings.length
          ? headings.length+' headings' : 'No headings';
        headings.forEach((heading,index)=>{
          const button=document.createElement('button');
          button.type='button';button.className='book-notebook__outline-link';
          button.style.paddingLeft=String(10 + (heading.level - 1) * 8) + 'px';
          button.textContent=heading.title;
          button.title='Line '+heading.line;
          button.addEventListener('click',()=>{
            if (previewMode === 'read' || previewMode === 'split') {
              const target=readingPreview.querySelectorAll('h2,h3,h4,h5,h6')[index];
              if(target){target.scrollIntoView({behavior:'smooth',block:'center'});return;}
            }
            setWritingView('write');
            body.focus();
            body.setSelectionRange(heading.offset,heading.offset);
          });
          outline.append(button);
        });
        if(!headings.length)paragraph(outline,'Use #, ##, or ### in your Markdown to create a navigable outline.');
      }

      function renderDashboard(): void {
        const overview = buildNotebookOverview(libraryNotes);
        const values: Record<string, number> = {
          notes: overview.total, books: overview.books,
          connections: overview.links, topics: overview.topics,
        };
        for (const element of dashboardStats.querySelectorAll<HTMLElement>('[data-dashboard-stat]'))
          element.textContent = String(values[element.dataset.dashboardStat ?? ''] ?? 0);
        dashboardRecent.replaceChildren();
        for (const note of overview.recentlyUpdated) {
          dashboardRecent.append(connectedWithPreview(note,
            bookName(note.workId) + ' · ' + new Date(note.updatedAt).toLocaleDateString()));
        }
        if (!overview.recentlyUpdated.length)
          paragraph(dashboardRecent, 'Begin a reading note to start your notebook.');
        dashboardTopics.replaceChildren();
        for (const { id, count } of overview.topicCounts.slice(0, 20)) {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'book-notebook__topic-chip';
          chip.textContent = '#' + id + ' · ' + count;
          chip.addEventListener('click', () => selectTopic(id));
          dashboardTopics.append(chip);
        }
        if (!overview.topicCounts.length)
          paragraph(dashboardTopics, 'Add a #topic/name marker to any note to group related ideas.');
        dashboardUnlinked.textContent = overview.total
          ? overview.unlinked + ' notes have no incoming or outgoing links yet.'
          : 'Your ideas will appear here once saved.';
      }

      function showLinkedPreview(note: BookNoteDocumentV1): void {
        linkedPreviewNote = note;
        peekOpener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        linkedPreviewTitle.textContent = notebookTitle(note);
        linkedPreviewSource.textContent = bookName(note.workId) + ' · '
          + note.scope.replace(/-/g, ' ') + ' · edited '
          + new Date(note.updatedAt).toLocaleDateString();
        renderNotebookPreview(linkedPreviewText, note.bodyMarkdown.slice(0, 12000), {
          notes: libraryNotes,
          onOpenNote: other => {
            linkedPreview.close();
            void openAnyNote(other);
          },
        });
        if (!linkedPreview.open) linkedPreview.showModal();
      }

      function connectedWithPreview(note: BookNoteDocumentV1, description?: string): HTMLElement {
        const row = document.createElement('div');
        row.className = 'book-notebook__connected-row';
        const open = connectedButton(note, description);
        const preview = document.createElement('button');
        preview.type = 'button';
        preview.className = 'book-notebook__peek-trigger';
        preview.textContent = 'Preview';
        preview.setAttribute('aria-label', 'Preview ' + notebookTitle(note));
        preview.addEventListener('click', () => showLinkedPreview(note));
        row.append(open, preview);
        return row;
      }

      function renderConnections(): void {
        outgoing.replaceChildren();
        backlinks.replaceChildren();
        suggestions.replaceChildren();
        sourceInfo.textContent = '';
        renderCurrentTopics();
        renderReadingView();
        sourceReader.hidden = true;
        sourceCopy.disabled = !selected;
        if (!selected) {
          paragraph(outgoing, 'Links and backlinks appear after this note is first saved.');
          paragraph(backlinks, 'Save this draft to create its note ID.');
          return;
        }
        const graph = notebookConnections(selected, libraryNotes, body.value);
        for (const link of graph.outbound) {
          outgoing.append(connectedWithPreview(link.target,
            (link.crossBook ? 'Another book · ' : '') + bookName(link.target.workId)));
        }
        for (const link of graph.missing) {
          const note = document.createElement('p');
          note.className = 'book-notebook__missing-link';
          note.textContent = 'Unavailable note: ' + (link.label || link.id);
          outgoing.append(note);
        }
        if (!graph.outbound.length && !graph.missing.length)
          paragraph(outgoing, 'No links yet. Use “Link note” to connect an idea.');
        for (const link of graph.inbound) {
          backlinks.append(connectedWithPreview(link.target,
            (link.crossBook ? 'Another book · ' : '') + bookName(link.target.workId)));
        }
        if (!graph.inbound.length) paragraph(backlinks, 'No notes link here yet.');
        const suggested = suggestRelatedNotebookNotes(selected, libraryNotes, body.value);
        for (const item of suggested) {
          suggestions.append(connectedWithPreview(item.note,
            'Shared words: ' + item.sharedTerms.join(', ')));
        }
        if (!suggested.length) paragraph(suggestions, 'No strong word overlap found yet.');
        sourceReader.hidden = readLink.hidden;
        if (!readLink.hidden) sourceReader.href = readLink.href;
        const anchor = selected.anchor;
        if (!anchor) {
          sourceInfo.textContent = 'Source: book-level note; no exact reader location captured.';
        } else if (anchor.format === 'epub') {
          sourceInfo.textContent = 'EPUB source: ' + (anchor.chapterLabel || anchor.chapterHref)
            + (anchor.cfi ? ' · exact CFI preserved' : ' · chapter anchor')
            + ' · edition ' + anchor.edition + ', release ' + anchor.releaseVersion;
        } else if (anchor.format === 'pdf') {
          sourceInfo.textContent = 'PDF source: page ' + anchor.page
            + ' · edition ' + anchor.edition + ', release ' + anchor.releaseVersion;
        } else {
          sourceInfo.textContent = 'Web chapter source: ' + anchor.chapterId;
        }
      }

      function renderLinkChoices(): void {
        linkResults.replaceChildren();
        if (!selected && !draft) {
          paragraph(linkResults, 'Open or create a notebook note first.');
          return;
        }
        const candidates = findNotebookNotes(libraryNotes, bookName, linkSearch.value, 24)
          .filter(note => note.id !== selected?.id);
        for (const note of candidates) {
          // Link insertion is deliberately different from navigation.
          const insert = document.createElement('button');
          insert.type = 'button';
          insert.className = 'book-notebook__connection';
          const heading = document.createElement('strong');
          heading.textContent = notebookTitle(note);
          const book = document.createElement('span');
          book.textContent = bookName(note.workId);
          insert.append(heading, book);
          insert.setAttribute('aria-label', 'Insert link to ' + notebookTitle(note));
          insert.addEventListener('click', () => {
            const edit = insertNotebookReference(
              body.value, body.selectionStart, body.selectionEnd, noteReferenceMarkdown(note));
            if (edit.value.length > body.maxLength) {
              mark('The note would exceed its maximum size.');
              return;
            }
            body.value = edit.value;
            body.focus();
            body.setSelectionRange(edit.selectionStart, edit.selectionEnd);
            body.dispatchEvent(new Event('input', { bubbles:true }));
            linkPicker.hidden = true;
            linkToggle.setAttribute('aria-expanded', 'false');
          });
          linkResults.append(insert);
        }
        if (!candidates.length) paragraph(linkResults, 'No matching saved notes.');
      }

      function renderDiscover(): void {
        discoverResults.replaceChildren();
        const candidates = workspaceNotes().slice(0, 60);
        discoverCount.textContent = libraryNotes.length + ' notes across '
          + new Set(libraryNotes.map(note => note.workId)).size + ' books';
        discoverEmpty.hidden = candidates.length > 0;
        savedViewStatus.textContent = candidates.length + ' matching notes'
          + (currentViewId ? ' · saved workspace active' : '');
        for (const note of candidates) {
          const button = connectedWithPreview(note);
          button.classList.add('book-notebook__discover-item');
          const snippet = document.createElement('small');
          snippet.textContent = note.bodyMarkdown
            .replace(/\s+/g, ' ').trim().slice(0, 125) || 'No text yet';
          button.append(snippet);
          const add = document.createElement('button');
          add.type = 'button';
          add.className = 'book-notebook__discovery-add';
          add.textContent = 'Add to research';
          add.setAttribute('aria-label', 'Add ' + notebookTitle(note) + ' to selected research collection');
          add.addEventListener('click', () => { void research.addNote(note.id); });
          button.append(add);
          discoverResults.append(button);
        }
      }

      async function refreshNetwork(): Promise<void> {
        const nonce = ++networkRequest;
        try {
          const documents = await listBookNotes();
          if (nonce !== networkRequest) return;
          libraryNotes = documents;
          // Imported notebook records remain browsable even when their original
          // EPUB/PDF or hosted work has been removed from this device.
          for (const workId of new Set(documents.map(note => note.workId))) {
            if (books.has(workId)) continue;
            const book = { id: workId, title: 'Unavailable source · ' + workId };
            books.set(workId, book);
            bookSelect.add(new Option(book.title, book.id));
          }
          const selectedBook = discoverBook.value;
          const listed = new Set(documents.map(note => note.workId));
          discoverBook.replaceChildren(new Option('All books', 'all'));
          for (const id of [...listed].sort((a,b) => bookName(a).localeCompare(bookName(b)))) {
            discoverBook.add(new Option(bookName(id),id));
          }
          discoverBook.value = listed.has(selectedBook) ? selectedBook : 'all';
          const currentTopic = discoverTopic.value;
          const managedTopic = topicManage.value;
          const topics = collectNotebookTopics(documents);
          discoverTopic.replaceChildren(new Option('All topics', 'all'));
          topicManage.replaceChildren(new Option('Choose topic…', ''));
          for (const item of topics) {
            discoverTopic.add(new Option('#' + item.id + ' (' + item.count + ')', item.id));
            topicManage.add(new Option('#' + item.id + ' · ' + item.count + ' notes', item.id));
          }
          discoverTopic.value = [...discoverTopic.options].some(option => option.value === currentTopic)
            ? currentTopic : 'all';
          topicManage.value = [...topicManage.options].some(option => option.value === managedTopic)
            ? managedTopic : '';
          renderSavedViews();
          renderDashboard();
          renderDiscover();
          renderGraph();
          renderLinkChoices();
          renderConnections();
        } catch {
          discoverCount.textContent = 'Notebook discovery unavailable on this device.';
          if (selected) paragraph(outgoing, 'Linked note lookup unavailable; your draft remains editable.');
        }
      }

      function useMarkdownTool(tool: MarkdownTool): void {
        if (!selected && !draft) return;
        const edit = applyNotebookMarkdownTool(body.value,body.selectionStart,body.selectionEnd,tool);
        if (edit.value.length > body.maxLength) {
          mark('The note would exceed its maximum size.');
          return;
        }
        body.value = edit.value;
        body.focus();
        body.setSelectionRange(edit.selectionStart,edit.selectionEnd);
        body.dispatchEvent(new Event('input',{bubbles:true}));
      }

      async function refresh(): Promise<void> {
        const id = currentBook(), nonce = ++loadNumber;
        if (!id) { renderNotes([]); return; }
        try {
          const notes = await listBookNotes(id);
          if (nonce !== loadNumber || id !== currentBook()) return;
          allNotes.splice(0, allNotes.length, ...notes);
          renderNotes(notes);
        } catch { setStatus('Notebook storage unavailable. Your unsaved text is still available for copying.'); }
      }

      async function chooseBook(value: string): Promise<void> {
        if (dirty() && !await save()) { bookSelect.value = selected?.workId ?? draft?.workId ?? ''; return; }
        hideEditor(); bookSelect.value = value;
        search.value = '';
        scopeFilter.value = 'all';
        const url = new URL(location.href);
        if (value) url.searchParams.set('work', value); else url.searchParams.delete('work');
        url.searchParams.delete('note');
        history.replaceState(null, '', url);
        updateBookControls(); await refresh();
        setStatus(value ? 'Notebook ready on this device.' : 'Select a book to begin.');
      }

      async function initialize(): Promise<void> {
        try {
          const raw = document.querySelector<HTMLElement>('[data-notebook-catalog]')?.dataset.notebookCatalog ?? '[]';
          for (const entry of JSON.parse(raw) as BookEntry[]) books.set(entry.id, entry);
          for (const personal of await getPersonalBooks()) {
            const id = personalReaderWorkId(personal);
            books.set(id, { id, title: personal.title, personal });
          }
        } catch { setStatus('Some personal books could not be loaded; existing notebook notes remain available.'); }
        const entries = [...books.values()].sort((a, b) => a.title.localeCompare(b.title));
        for (const entry of entries) {
          const option = new Option(entry.title, entry.id); bookSelect.append(option);
        }
        const initialParams = new URL(location.href).searchParams;
        const requested = initialParams.get('work');
        const desiredNote = initialParams.get('note');
        if (requested && !books.has(requested)) {
          bookSelect.add(new Option('Unavailable book: ' + requested, requested));
          setStatus('Source file unavailable. Your existing notes remain accessible.');
        }
        await chooseBook(requested ?? '');
        await refreshNetwork();
        await research.refresh();
        if (desiredNote && requested) {
          const match = allNotes.find((item) => item.id === desiredNote);
          if (match) openEditor(match);
        }
      }



      function filtersChanged(): void {
        currentViewId = '';
        savedView.value = '';
        renderDiscover();
        renderGraph();
      }

      function applyWorkspaceFilters(filters: NotebookViewFilters): void {
        discoverQuery.value = filters.query;
        discoverBook.value = filters.workId;
        discoverTopic.value = filters.topic;
        discoverScope.value = filters.scope;
        discoverLinks.value = filters.mode;
        discoverSort.value = filters.sort;
        renderDiscover();
        renderGraph();
      }

      root.querySelector('[data-view-save]')?.addEventListener('click', () => {
        try {
          const saved = saveNotebookView(savedViewName.value, currentWorkspaceFilters());
          currentViewId = saved[0].id;
          renderSavedViews();
          savedView.value = currentViewId;
          savedViewName.value = '';
          savedViewStatus.textContent = 'Saved workspace: ' + saved[0].name
            + '. Stored on this device only.';
        } catch(error) {
          savedViewStatus.textContent = error instanceof Error ? error.message : 'Cannot save this view.';
        }
      });

      root.querySelector('[data-view-apply]')?.addEventListener('click', () => {
        const view=readSavedNotebookViews().find(item => item.id === savedView.value);
        if(!view){savedViewStatus.textContent='Choose a saved view first.';return;}
        currentViewId=view.id;
        const works=new Set(libraryNotes.map(note=>note.workId));
        const topics=new Set(collectNotebookTopics(libraryNotes).map(topic=>topic.id));
        applyWorkspaceFilters(filtersForSavedView(view,works,topics));
        savedViewStatus.textContent='Opened "' + view.name
          + '". Missing books or topics fall back to All.';
      });

      root.querySelector('[data-view-delete]')?.addEventListener('click', () => {
        const selected=readSavedNotebookViews().find(item=>item.id===savedView.value);
        if(!selected){savedViewStatus.textContent='Choose a saved view to remove.';return;}
        if(!window.confirm('Remove saved view "'+selected.name+'"? Your notebook notes will not be deleted.'))return;
        try {
          deleteNotebookView(selected.id);
          currentViewId='';
          renderSavedViews();
          savedViewStatus.textContent='Saved view removed; existing note filters remain available.';
        } catch(error){savedViewStatus.textContent=error instanceof Error?error.message:'Cannot remove view.';}
      });

      root.querySelector('[data-view-clear]')?.addEventListener('click', () => {
        currentViewId='';
        savedView.value='';
        applyWorkspaceFilters(defaultNotebookView());
        savedViewStatus.textContent='Showing all notes, regardless of book, topic or connections.';
      });

      graphToggle.addEventListener('click', () => {
        graphPanel.hidden=!graphPanel.hidden;
        graphToggle.setAttribute('aria-expanded',String(!graphPanel.hidden));
        graphToggle.textContent=graphPanel.hidden?'Explore graph':'Hide graph';
        if(!graphPanel.hidden)renderGraph();
      });
      graphEdges.addEventListener('change',renderGraph);
      graphZoom.addEventListener('input',renderGraph);
      root.querySelector('[data-graph-reset]')?.addEventListener('click',()=>{
        graphFocus=undefined;
        graphZoom.value='100';
        renderGraph();
      });
      graphPreviewButton.addEventListener('click',()=>{
        const note=libraryNotes.find(item=>item.id===graphFocus);
        if(note)showLinkedPreview(note);
      });
      graphOpenButton.addEventListener('click',()=>{
        const note=libraryNotes.find(item=>item.id===graphFocus);
        if(note)void openAnyNote(note);
      });

      async function mutateTopicEverywhere(removal: boolean): Promise<void> {
        if(topicMutationBusy || saving)return;
        const from=topicManage.value;
        const to=removal?null:normalizeNotebookTopic(topicManageName.value);
        if(!from){topicManageStatus.textContent='Choose an existing topic first.';return;}
        if(!removal && (!to || to===from)){
          topicManageStatus.textContent='Enter a different valid topic name.';return;
        }
        if(dirty() && !await save()){
          topicManageStatus.textContent='Unable to save the open draft. Download it before proceeding.';
          return;
        }
        let candidates: Array<{note: BookNoteDocumentV1; newBody:string}> = [];
        try {
          const current=await listBookNotes();
          candidates=current.flatMap(note=>{
            const edit=rewriteNotebookTopic(note.bodyMarkdown,from,to);
            return edit.replacements ? [{note,newBody:edit.after}] : [];
          });
        } catch(error){
          topicManageStatus.textContent=error instanceof Error?error.message:'Notebook storage unavailable.';
          return;
        }
        if(!candidates.length){topicManageStatus.textContent='No saved notes contain that topic.';return;}
        const action=removal?'remove #'+from:'rename #'+from+' to #'+to;
        if(!window.confirm('This will '+action+' in '+candidates.length+
          ' saved notes across your books. A local JSON backup download is requested first. Continue?'))return;
        topicMutationBusy=true;
        const buttons=root!.querySelectorAll<HTMLButtonElement>('[data-topic-rename],[data-topic-remove]');
        buttons.forEach(button=>{button.disabled=true;});
        let changed=0;
        try {
          // A V2 snapshot is requested before any local note mutation.
          const backup=await createLibraryBackupJson();
          const url=URL.createObjectURL(new Blob([backup],{type:'application/json;charset=utf-8'}));
          const anchor=document.createElement('a');
          anchor.href=url;
          anchor.download='thiepn-library-before-topic-edit.json';
          document.body.append(anchor);
          anchor.click();anchor.remove();
          window.setTimeout(()=>URL.revokeObjectURL(url),10000);
          topicManageStatus.textContent='Backup download requested. Updating notes one at a time…';
          for(const item of candidates) {
            const next=await updateBookNote(item.note.id,item.note.revision,{
              title:item.note.title,bodyMarkdown:item.newBody,
            });
            changed++;
            if(selected?.id===next.id) {
              selected=next;
              body.value=next.bodyMarkdown;
              savedTitle=next.title;savedBody=next.bodyMarkdown;
              mark('Topic updated and saved locally.');
              updateWritingStats();
              renderOutline();
            }
          }
          topicManageStatus.textContent=changed+' notes updated. The changes are stored locally.';
          topicManageName.value='';
        } catch(error) {
          topicManageStatus.textContent=changed+' notes updated before stopping. '
            +(error instanceof Error?error.message:'Unable to finish topic update.')
            +' Remaining notes were not changed. Keep the safety backup.';
        } finally {
          topicMutationBusy=false;
          buttons.forEach(button=>{button.disabled=false;});
          void refresh();
          void refreshNetwork();
        }
      }
      root.querySelector('[data-topic-rename]')?.addEventListener('click',
        ()=>{void mutateTopicEverywhere(false);});
      root.querySelector('[data-topic-remove]')?.addEventListener('click',
        ()=>{void mutateTopicEverywhere(true);});

      historyBack.addEventListener('click',()=>{void moveNoteHistory(-1);});
      historyForward.addEventListener('click',()=>{void moveNoteHistory(1);});
      updateNoteHistory();
      discoverQuery.addEventListener('input', filtersChanged);
      discoverBook.addEventListener('change', filtersChanged);
      discoverTopic.addEventListener('change', filtersChanged);
      discoverScope.addEventListener('change', filtersChanged);
      discoverLinks.addEventListener('change', filtersChanged);
      discoverSort.addEventListener('change', filtersChanged);
      root.querySelectorAll<HTMLButtonElement>('[data-notebook-view]').forEach(button => {
        button.addEventListener('click', () => {
          const mode = button.dataset.notebookView;
          if (mode === 'write' || mode === 'split' || mode === 'read') setWritingView(mode);
        });
      });
      root.querySelector('[data-notebook-insert-template]')?.addEventListener('click', () => {
        const template = NOTEBOOK_TEMPLATES.find(item => item.id === templateSelect.value);
        if (!template) { mark('Choose a writing template first.'); return; }
        insertAtCursor(template.markdown);
        mark('Template inserted into the draft. Your previous text was preserved.');
      });
      root.querySelector('[data-notebook-insert-table]')?.addEventListener('click', () => {
        insertAtCursor('| Idea | Evidence | Reflection |\n| --- | --- | --- |\n|  |  |  |\n');
      });
      root.querySelector('[data-notebook-insert-divider]')?.addEventListener('click', () => {
        insertAtCursor('---\n');
      });
      root.querySelector('[data-notebook-topic-add]')?.addEventListener('click', () => {
        if (!selected && !draft) { setStatus('Open a note before adding topics.'); return; }
        const topic = normalizeNotebookTopic(topicInput.value);
        if (!topic) { mark('Enter a topic name using letters or numbers.'); topicInput.focus(); return; }
        if (extractNotebookTopics(body.value).includes(topic)) {
          mark('This topic is already part of the note.');
          topicInput.select();
          return;
        }
        const edit = insertNotebookText(body.value, body.value.length, body.value.length,
          '#topic/' + topic);
        if (edit.value.length > body.maxLength) { mark('This note has reached its size limit.'); return; }
        setWritingView('write');
        body.value = edit.value;
        body.setSelectionRange(edit.cursor, edit.cursor);
        topicInput.value = '';
        body.dispatchEvent(new Event('input', { bubbles: true }));
        mark('Topic added to Markdown and will be saved locally.');
      });
      topicInput.addEventListener('keydown', event => {
        if (event.key === 'Enter') {
          event.preventDefault();
          root!.querySelector<HTMLButtonElement>('[data-notebook-topic-add]')?.click();
        }
      });
      linkedPreviewClose.addEventListener('click', () => linkedPreview.close());
      linkedPreview.addEventListener('close', () => {
        linkedPreviewNote = undefined;
        if (peekOpener?.isConnected) peekOpener.focus({ preventScroll: true });
        peekOpener = null;
      });
      linkedPreviewOpen.addEventListener('click', () => {
        const note = linkedPreviewNote;
        if (!note) return;
        peekOpener = null;
        linkedPreview.close();
        void openAnyNote(note);
      });
      linkedPreviewCopy.addEventListener('click', async () => {
        if (!linkedPreviewNote) return;
        try {
          await navigator.clipboard.writeText(noteReferenceMarkdown(linkedPreviewNote));
          linkedPreviewCopy.textContent = 'Copied link';
          window.setTimeout(() => { linkedPreviewCopy.textContent = 'Copy note reference'; }, 1500);
        } catch {
          linkedPreviewCopy.textContent = 'Clipboard unavailable';
        }
      });
      linkSearch.addEventListener('input', renderLinkChoices);
      linkToggle.addEventListener('click', () => {
        if (!selected && !draft) return;
        linkPicker.hidden = !linkPicker.hidden;
        linkToggle.setAttribute('aria-expanded', String(!linkPicker.hidden));
        if (!linkPicker.hidden) { renderLinkChoices(); linkSearch.focus(); }
      });
      root.querySelector('[data-notebook-link-close]')?.addEventListener('click', () => {
        linkPicker.hidden = true;
        linkToggle.setAttribute('aria-expanded','false');
        body.focus();
      });
      root.querySelectorAll<HTMLButtonElement>('[data-markdown-tool]').forEach(button => {
        button.addEventListener('click', () => {
          useMarkdownTool(button.dataset.markdownTool as MarkdownTool);
        });
      });
      body.addEventListener('keydown', event => {
        if ((event.ctrlKey || event.metaKey) && !event.altKey) {
          if (event.key.toLowerCase() === 'b' || event.key.toLowerCase() === 'i') {
            event.preventDefault();
            useMarkdownTool(event.key.toLowerCase() === 'b' ? 'bold' : 'italic');
          }
        }
      });
      sourceCopy.addEventListener('click', async () => {
        if (!selected) return;
        const location = sourceInfo.textContent ?? '';
        const reference = bookName(selected.workId) + '\n' + location
          + '\nNote ID: ' + selected.id;
        try {
          await navigator.clipboard.writeText(reference);
          mark('Source reference copied.');
        } catch {
          mark('Clipboard unavailable. Select and copy the source details above.');
        }
      });
      focusToggle.addEventListener('click', () => {
        const focused = !editor.classList.contains('book-notebook__editor--focus');
        editor.classList.toggle('book-notebook__editor--focus',focused);
        focusToggle.setAttribute('aria-pressed',String(focused));
        if (focused) body.focus();
      });

      root.querySelectorAll<HTMLButtonElement>('[data-notebook-create]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const scope = btn.dataset.notebookCreate as BookNoteScope;
          if (!currentBook()) return;
          if (scope === 'chapter-summary') {
            chapterPane.hidden = false; chapterKeyInput.focus(); return;
          }
          if (scope === 'book-overview') {
            const existing = allNotes.find((note) => note.scope === 'book-overview');
            await switchEditor(existing, existing ? undefined : { workId: currentBook(), scope, title: 'Book overview' });
          } else await switchEditor(undefined, { workId: currentBook(), scope, title: 'Reading note' });
        });
      });
      root.querySelector('[data-notebook-chapter-confirm]')?.addEventListener('click', async () => {
        const chapterKey = normalizedChapterKey(chapterKeyInput.value);
        if (!chapterKey || !currentBook()) { setStatus('Enter a chapter heading or page reference.'); return; }
        const existing = allNotes.find((note) => note.scope === 'chapter-summary' && note.chapterKey === chapterKey);
        chapterPane.hidden = true;
        await switchEditor(existing, existing ? undefined : {
          workId: currentBook(), scope: 'chapter-summary', chapterKey, title: chapterKeyInput.value.trim(),
        });
      });
      root.querySelector('[data-notebook-chapter-cancel]')?.addEventListener('click', () => { chapterPane.hidden = true; });
      bookSelect.addEventListener('change', () => { void chooseBook(bookSelect.value); });
      search.addEventListener('input', () => renderNotes(allNotes));
      scopeFilter.addEventListener('change', () => renderNotes(allNotes));
      sortBy.addEventListener('change', () => renderNotes(allNotes));
      title.addEventListener('input', scheduleSave);
      body.addEventListener('input', () => {
        scheduleSave();
        updateWritingStats();
        renderOutline();
        renderConnections();
        renderReadingView();
      });
      title.addEventListener('blur', () => { if (dirty()) void save(); });
      body.addEventListener('blur', () => { if (dirty()) void save(); });
      editor.addEventListener('keydown', (event) => {
        if (event.altKey && !event.ctrlKey && !event.metaKey
          && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
          event.preventDefault();
          void moveNoteHistory(event.key === 'ArrowLeft' ? -1 : 1);
          return;
        }
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 's') {
          event.preventDefault(); void save();
        }
      });
      root.querySelector('[data-notebook-add-research]')?.addEventListener('click', async () => {
        if (!selected && !draft) return;
        if (!selected && !dirty()) {
          setStatus('Write some content and save this draft before adding it to research.');
          return;
        }
        if (dirty() && !await save()) {
          setStatus('Save the current notebook text or download the editor draft before collecting it.');
          return;
        }
        if (selected) await research.addNote(selected.id);
      });
      root.querySelector('[data-notebook-save]')?.addEventListener('click', () => { void save(); });
      root.querySelector('[data-notebook-close]')?.addEventListener('click', async () => {
        if (dirty() && !await save()) return; hideEditor();
        root.querySelector<HTMLButtonElement>('[data-notebook-create="reading-note"]')?.focus();
      });
      root.querySelector('[data-notebook-copy]')?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('# ' + title.value + '\n\n' + body.value + '\n');
          mark('Copied to clipboard');
        } catch { mark('Clipboard unavailable. Select and copy the editor text directly.'); }
      });
      root.querySelector('[data-notebook-recover]')?.addEventListener('click', () => {
        const note = selected ?? draft;
        if (!note) return;
        downloadNotebookRecovery({
          workId: note.workId, scope: note.scope,
          title: title.value, bodyMarkdown: body.value,
          ...(selected ? { id: selected.id } : {}),
          ...(note.chapterKey ? { chapterKey: note.chapterKey } : {}),
          ...(note.anchor ? { anchor: note.anchor } : {}),
        });
        mark('Editor draft downloaded separately. This is not a confirmed save.');
      });
      removeButton.addEventListener('click', async () => {
        if (!selected) return;
        if (!deletionArmed) { deletionArmed = true; removeButton.textContent = 'Confirm delete'; return; }
        try {
          await deleteBookNote(selected.id, selected.revision);
          hideEditor(); await refresh(); setStatus('Notebook note deleted; highlights remain untouched.');
        } catch { setStatus('Delete failed. This note may have changed in another tab.'); }
      });
      exportButton.addEventListener('click', async () => {
        if (!currentBook()) return;
        // Never issue a successful-looking export that silently excludes unsaved editor changes.
        if (dirty() && !await save()) {
          setStatus('Save did not finish. Download the editor draft before exporting this book.');
          return;
        }
        try {
          const notes = await listBookNotes(currentBook());
          const text = bookNotebookToObsidianMarkdown(currentBook(), books.get(currentBook())?.title ?? currentBook(), notes);
          download('thiepn-notebook-' + currentBook().replace(/[^a-zA-Z0-9-]/g, '-') + '.md', text);
          setStatus('Exported this book notebook as Obsidian-compatible Markdown, including source identifiers.');
        } catch (error) {
          setStatus(error instanceof Error ? error.message : 'Unable to export. Download your editor draft instead.');
        }
      });
      window.addEventListener('beforeunload', (event) => {
        if (!dirty()) return;
        event.preventDefault();
        event.returnValue = '';
      });
      const unsubscribe = subscribeBookNotes(() => {
        if (dirty()) mark('Another tab changed the notebook. Save or copy your draft before reloading.');
        else void refresh();
        void refreshNetwork();
      });
      const researchRoot = root.querySelector<HTMLElement>('[data-research-root]')!;
      const research = mountResearchWorkbench(researchRoot, {
        bookTitle: workId => bookName(workId),
        sourceHref: note => {
          const entry = books.get(note.workId);
          if (!entry) return undefined;
          if (entry.personal) {
            const isPdf = entry.personal.format === 'pdf';
            const route = isPdf ? 'pdf' : 'read';
            const origin = `${base}/personal/${route}?id=${encodeURIComponent(entry.personal.id)}`;
            const annotation = !isPdf && note.anchor?.format === 'epub'
              ? note.sourceAnnotations.find(source => source.format === 'epub') : undefined;
            return annotation ? origin + '&annotation=' + encodeURIComponent(annotation.id) : origin;
          }
          if (!entry.slug) return undefined;
          const origin = `${base}/works/${encodeURIComponent(entry.slug)}`;
          if (note.anchor?.format === 'pdf') {
            return entry.hasPdf ? origin + '/pdf' : undefined;
          }
          const annotation = note.anchor?.format === 'epub'
            ? note.sourceAnnotations.find(source => source.format === 'epub') : undefined;
          return origin + '/read'
            + (annotation ? '?annotation=' + encodeURIComponent(annotation.id) : '');
        },
        openNote: note => openAnyNote(note),
      });
      window.addEventListener('pagehide', () => {
        unsubscribe();
        research.dispose();
      }, { once: true });
      void initialize();
    }
  </script>
</BaseLayout>
