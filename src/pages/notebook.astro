      const graphNeighborsList = root.querySelector<HTMLElement>('[data-graph-neighbors]')!;
      const graphPreviewButton = root.querySelector<HTMLButtonElement>('[data-graph-preview]')!;
      const graphOpenButton = root.querySelector<HTMLButtonElement>('[data-graph-open]')!;
      const discoverResults = root.querySelector<HTMLElement>('[data-discover-results]')!;
      const discoverCount = root.querySelector<HTMLElement>('[data-discover-count]')!;
      const discoverEmpty = root.querySelector<HTMLElement>('[data-discover-empty]')!;
      const linkPicker = root.querySelector<HTMLElement>('[data-notebook-link-picker]')!;
      const linkSearch = root.querySelector<HTMLInputElement>('[data-notebook-link-search]')!;
      const linkResults = root.querySelector<HTMLElement>('[data-notebook-link-results]')!;
