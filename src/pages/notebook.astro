      const savedViewStatus = root.querySelector<HTMLElement>('[data-view-status]')!;
      const outline = root.querySelector<HTMLElement>('[data-notebook-outline]')!;
      const outlineCount = root.querySelector<HTMLElement>('[data-outline-count]')!;
      const topicManage = root.querySelector<HTMLSelectElement>('[data-topic-manage-select]')!;
      const topicManageName = root.querySelector<HTMLInputElement>('[data-topic-manage-name]')!;
      const topicManageStatus = root.querySelector<HTMLElement>('[data-topic-manage-status]')!;
      const graphPanel = root.querySelector<HTMLElement>('[data-graph-panel]')!;
