---
import EpubReaderLayout from '../../layouts/EpubReaderLayout.astro';
import ReaderShell from '../../components/reader/ReaderShell.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<EpubReaderLayout title="Read personal book" description="Read a personal EPUB stored locally in this browser." noindex>
  <ReaderShell
    title="Personal book"
    subtitle="Stored on this device"
    backHref={`${base}/saved`}
    backLabel="Back to My Library"
    loadingMessage="Opening personal book…"
  />
  <script>
    import { getPersonalBook, personalReaderReleaseVersion, personalReaderWorkId } from '../../lib/client/personal-books';
    import { setReaderFailureState } from '../../lib/reader/fallback';
    import type { ReaderSourceFallbackHarnessHandle } from '../../lib/reader/fallback-harness';
    import { ReaderPerformanceController } from '../../lib/reader/performance';
    import { mountReaderShell } from '../../lib/reader/shell';
    import { recordReadingOpen } from '../../lib/reading-activity/client';

    const root = document.querySelector<HTMLElement>('[data-reader-shell]');
    const readerPerformance = root ? new ReaderPerformanceController(root) : undefined;
    let mounted: ReaderSourceFallbackHarnessHandle | undefined;
    let bootstrapRetry: ((event: MouseEvent) => void) | undefined;
    let closing = false;

    readerPerformance?.start();

    function setIdentity(title: string, creator?: string) {
      const titleNode = root?.querySelector<HTMLElement>('[data-reader-title]');
      const subtitle = root?.querySelector<HTMLElement>('.reader-shell__identity span');
      if (titleNode) titleNode.textContent = title;
      if (subtitle) subtitle.textContent = creator || 'Personal EPUB · stored on this device';
      document.title = `${title} — Thiepn Library`;
    }

    function fail(error: unknown) {
      if (!root) return;
      const shell = mountReaderShell(root);
      const failure = setReaderFailureState(shell, error);
      const retry = root.querySelector<HTMLButtonElement>('[data-reader-command="retry"]');
      if (!failure.retryable || !retry) return;
      retry.textContent = 'Reload page';
      bootstrapRetry = (event: MouseEvent) => {
        const origin = event.target instanceof Element ? event.target : null;
        const button = origin?.closest<HTMLElement>('[data-reader-command="retry"]');
        if (!button || !root.contains(button)) return;
        event.preventDefault();
        location.reload();
      };
      root.addEventListener('click', bootstrapRetry);
    }

    async function boot() {
      if (!root || closing) return;
      try {
        const id = new URL(location.href).searchParams.get('id')?.trim();
        if (!id) throw new Error('No personal book was selected. Return to My Library and choose a book.');
        const book = await getPersonalBook(id);
        if (!book) throw new Error('This personal book is no longer stored in this browser.');
        if (book.format !== 'epub') throw new Error('This personal book is not an EPUB.');
        if (closing) return;

        setIdentity(book.title, book.creator);
        const source = await book.file.arrayBuffer();
        if (closing) return;

        readerPerformance?.markModuleLoading();
        const { mountReaderSourceWithFallbackHarness } = await import('../../lib/reader/fallback-harness');
        if (closing) return;
        readerPerformance?.markOpening();

        const identity = {
          workId: personalReaderWorkId(book),
          edition: 1,
          releaseVersion: personalReaderReleaseVersion(book),
        };
        void recordReadingOpen({ ...identity, format: 'epub', source: 'personal' }).catch(() => {});
        const handle = await mountReaderSourceWithFallbackHarness(root, {
          source,
          identity,
        });
        if (closing) handle.destroy();
        else mounted = handle;
      } catch (error) {
        fail(error);
      }
    }

    requestAnimationFrame(() => {
      readerPerformance?.markShellPainted();
      void boot();
    });

    window.addEventListener('pagehide', () => {
      closing = true;
      if (root && bootstrapRetry) root.removeEventListener('click', bootstrapRetry);
      bootstrapRetry = undefined;
      mounted?.destroy();
      mounted = undefined;
      readerPerformance?.destroy();
    }, { once: true });
  </script>
</EpubReaderLayout>
