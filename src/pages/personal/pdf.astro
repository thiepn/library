---
import PdfReaderLayout from '../../layouts/PdfReaderLayout.astro';
import PdfReaderShell from '../../components/PdfReaderShell.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const backHref = `${base}/saved`;
---
<PdfReaderLayout title="Personal PDF" description="Open a personal PDF stored locally in this browser." noindex>
  <PdfReaderShell
    title="Personal PDF"
    backHref={backHref}
    backLabel="Back to My Library"
    metadata="Stored on this device"
  />
  <script>
    import { getPersonalBook, personalReaderReleaseVersion, personalReaderWorkId } from '../../lib/client/personal-books';
    import { mountPdfReader, type PdfReaderHandle } from '../../lib/pdf-reader';
    import type { PdfCanonicalCandidate } from '../../lib/pdf-reader/canonical';
    import { recordReadingOpen } from '../../lib/reading-activity/client';

    const root = document.querySelector<HTMLElement>('[data-pdf-reader-root]');
    const title = root?.querySelector<HTMLElement>('.pdf-reader__title');
    const meta = root?.querySelector<HTMLElement>('.pdf-reader__meta');
    let mounted: PdfReaderHandle | undefined;
    let objectUrl: string | undefined;
    let reload: (() => void) | undefined;

    const formatBytes = (bytes: number) => bytes < 1024 * 1024
      ? `${Math.max(1, Math.round(bytes / 1024))} KB`
      : `${(bytes / (1024 * 1024)).toFixed(bytes >= 10 * 1024 * 1024 ? 0 : 1)} MB`;

    function configureFallback(url: string) {
      for (const anchor of root?.querySelectorAll<HTMLAnchorElement>('[data-pdf-fallback]') ?? []) {
        anchor.href = url;
        anchor.hidden = false;
      }
    }

    function bootstrapFailure(message: string) {
      if (!root) return;
      root.dataset.pdfReaderState = 'error';
      root.removeAttribute('aria-busy');
      const error = root.querySelector<HTMLElement>('[data-pdf-error]');
      const errorMessage = root.querySelector<HTMLElement>('[data-pdf-error-message]');
      const status = root.querySelector<HTMLElement>('[data-pdf-status]');
      const retry = root.querySelector<HTMLButtonElement>('[data-pdf-retry]');
      if (errorMessage) errorMessage.textContent = message;
      if (error) error.hidden = false;
      if (status) status.hidden = true;
      if (retry) {
        reload = () => location.reload();
        retry.addEventListener('click', reload, { once: true });
      }
    }

    async function boot() {
      try {
        if (!root) throw new Error('The PDF reader shell is unavailable.');
        const id = new URL(location.href).searchParams.get('id')?.trim();
        if (!id) throw new Error('No personal book was selected.');
        const book = await getPersonalBook(id);
        if (!book) throw new Error('This personal book is no longer stored in this browser.');
        if (book.format !== 'pdf') throw new Error('This personal book is not a PDF.');

        if (title) title.textContent = book.title;
        if (meta) meta.textContent = `${formatBytes(book.size)} · local PDF · stored on this device`;
        document.title = `${book.title} — Thiepn Library`;

        objectUrl = URL.createObjectURL(book.file);
        configureFallback(objectUrl);
        const source = await book.file.arrayBuffer();
        const identity = {
          workId: personalReaderWorkId(book),
          edition: 1,
          releaseVersion: personalReaderReleaseVersion(book),
        };
        void recordReadingOpen({ ...identity, format: 'pdf', source: 'personal' }).catch(() => {});
        const candidate: PdfCanonicalCandidate = {
          source,
          identity,
          title: book.title,
          ...(book.language ? { language: book.language } : {}),
          fallbackUrl: objectUrl,
          backHref: location.pathname.replace(/\/personal\/pdf\/?$/, '/saved'),
        };
        mounted = await mountPdfReader(root, candidate);
      } catch (error) {
        bootstrapFailure(error instanceof Error ? error.message : 'Unable to open this personal PDF.');
      }
    }

    requestAnimationFrame(() => void boot());
    window.addEventListener('pagehide', () => {
      const retry = root?.querySelector<HTMLButtonElement>('[data-pdf-retry]');
      if (retry && reload) retry.removeEventListener('click', reload);
      void mounted?.destroy();
      mounted = undefined;
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = undefined;
    }, { once: true });
  </script>
</PdfReaderLayout>
