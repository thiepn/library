---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Not found" noindex>
  <div class="page"><section class="section"><div class="empty"><p class="eyebrow">404</p><h2>This shelf does not exist.</h2><p><a href={base}>Return to the Library</a></p></div></section></div>
</BaseLayout>
