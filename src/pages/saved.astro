---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getWorks } from '../lib/content/repository';
const works = await getWorks();
---
<BaseLayout title="My Library" description="Books you have saved to your browser-local personal library." noindex>
  <div class="page">
    <section class="section">
      <div class="section-heading"><div><p class="eyebrow">Your books</p><h1>My Library</h1></div><p class="micro" data-saved-count>Loading your books…</p></div>
      <div class="work-list saved-list" data-saved-list>
        {works.map((work, index) => <div class="saved-work" data-saved-work={work.id} hidden><WorkCard work={work} index={index + 1} /></div>)}
      </div>
      <div class="empty" data-saved-empty hidden><h2>Your Library is empty.</h2><p>Add a book to My Library from the catalog or a book details page. Your saved list stays in this browser and does not require an account.</p></div>
    </section>
  </div>
  <script>
    import { getFavoriteWorkIds, subscribeLibraryState } from '../lib/client/library-db';
    const count = document.querySelector<HTMLElement>('[data-saved-count]');
    const empty = document.querySelector<HTMLElement>('[data-saved-empty]');
    const nodes = [...document.querySelectorAll<HTMLElement>('[data-saved-work]')];
    async function render() {
      try {
        const ids = new Set(await getFavoriteWorkIds());
        let visible = 0;
        for (const node of nodes) {
          const show = Boolean(node.dataset.savedWork && ids.has(node.dataset.savedWork));
          node.hidden = !show;
          if (show) visible++;
        }
        if (count) count.textContent = `${visible} book${visible === 1 ? '' : 's'}`;
        if (empty) empty.hidden = visible !== 0;
      } catch {
        if (count) count.textContent = 'Local library unavailable';
        if (empty) { empty.hidden = false; empty.querySelector('p')!.textContent = 'This browser did not allow the local Library database to open.'; }
      }
    }
    const unsubscribe = subscribeLibraryState(() => { void render(); });
    window.addEventListener('pagehide', unsubscribe, { once: true });
    void render();
  </script>
</BaseLayout>
