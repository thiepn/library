---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getWorks } from '../lib/content/repository';
import '../styles/personal-library.css';
const works = await getWorks();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="My Library" description="Books you have saved or imported into your browser-local personal library." noindex>
  <div class="page">
    <section class="section">
      <div class="section-heading"><div><p class="eyebrow">Your books</p><h1>My Library</h1></div><p class="micro" data-saved-count>Loading your books…</p></div>

      <div class="reading-state-toolbar" data-reading-filters aria-label="Filter My Library by reading status">
        <div class="reading-state-filters">
          <button type="button" data-reading-filter="all" aria-pressed="true">All</button>
          <button type="button" data-reading-filter="in-progress" aria-pressed="false">Reading</button>
          <button type="button" data-reading-filter="not-started" aria-pressed="false">Saved for later</button>
          <button type="button" data-reading-filter="completed" aria-pressed="false">Finished</button>
        </div>
        <p class="micro" data-reading-state-summary aria-live="polite">Reading state loading…</p>
      </div>

      <section class="personal-import" aria-labelledby="personal-import-title">
        <div class="personal-import__copy">
          <p class="eyebrow">Personal books</p>
          <h2 id="personal-import-title">Add your own books</h2>
          <p>Import an EPUB or PDF from this device and keep it in My Library.</p>
          <p class="personal-import__privacy">Files stay in this browser. Thiepn Library does not upload your personal books.</p>
        </div>
        <div class="personal-import__actions">
          <input data-personal-file-input type="file" accept=".epub,.pdf,application/epub+zip,application/pdf" multiple hidden />
          <button class="personal-import__button" type="button" data-personal-file-button>Choose EPUB or PDF</button>
        </div>
        <div class="personal-import__drop" data-personal-drop tabindex="0">Or drop EPUB/PDF files here</div>
        <p class="personal-import__status" data-personal-import-status aria-live="polite"></p>
        <p class="personal-import__status" data-personal-offline-status aria-live="polite"></p>
      </section>

      <section class="personal-books" data-personal-books-section hidden aria-labelledby="personal-books-title">
        <div class="personal-books__heading">
          <div><p class="eyebrow">On this device</p><h2 id="personal-books-title">Imported books</h2></div>
          <p class="micro" data-personal-count></p>
        </div>
        <div class="personal-books__grid" data-personal-books-list></div>
      </section>

      <div class="work-list saved-list" data-saved-list>
        {works.map((work, index) => <div
          class="saved-work"
          data-saved-work={work.id}
          data-edition={work.publication.edition}
          data-release-version={work.release?.version ?? ''}
          data-reader-href={work.webMaterialized ? `${base}/works/${work.slug}/read` : undefined}
          data-has-epub={work.release?.artifacts.epub ? 'true' : 'false'}
          data-pdf-href={work.release?.artifacts.pdf ? `${base}/works/${work.slug}/pdf` : undefined}
          hidden
        ><WorkCard work={work} index={index + 1} /></div>)}
      </div>
      <div class="empty" data-library-error role="alert" hidden>
        <h2>My Library couldn’t load.</h2>
        <p data-library-error-message>Check browser storage settings, then try again.</p>
        <button class="personal-import__button" type="button" data-library-retry>Try again</button>
      </div>
      <div class="empty" data-saved-empty hidden><h2>Your Library is empty.</h2><p>Import an EPUB or PDF above, or add a book from the Library catalog. Your personal library stays in this browser and does not require an account.</p></div>
    </section>
  </div>
  <script>
    import { deleteReadingActivity, getFavoriteWorkIds } from '../lib/client/library-db';
    import { preparePersonalReadersForOffline } from '../lib/client/offline-library';
    import {
      deletePersonalBook,
      getPersonalBooks,
      importPersonalBook,
      personalReaderReleaseVersion,
      personalReaderWorkId,
      requestPersonalLibraryPersistence,
      subscribePersonalBooks,
      type PersonalBookSummary,
    } from '../lib/client/personal-books';
    import { normalizeLibraryStorageError } from '../lib/client/storage-reliability';
    import { getReadingContinuity, subscribeUnifiedReadingState } from '../lib/reader-entry/client';
    import { readingActionLabel, readingPositionLabel } from '../lib/reader-entry/continuity';

    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const count = document.querySelector<HTMLElement>('[data-saved-count]');
    const empty = document.querySelector<HTMLElement>('[data-saved-empty]');
    const libraryError = document.querySelector<HTMLElement>('[data-library-error]');
    const libraryErrorMessage = document.querySelector<HTMLElement>('[data-library-error-message]');
    const libraryRetry = document.querySelector<HTMLButtonElement>('[data-library-retry]');
    const hostedNodes = [...document.querySelectorAll<HTMLElement>('[data-saved-work]')];
    const personalSection = document.querySelector<HTMLElement>('[data-personal-books-section]');
    const personalList = document.querySelector<HTMLElement>('[data-personal-books-list]');
    const personalCount = document.querySelector<HTMLElement>('[data-personal-count]');
    const input = document.querySelector<HTMLInputElement>('[data-personal-file-input]');
    const chooseButton = document.querySelector<HTMLButtonElement>('[data-personal-file-button]');
    const drop = document.querySelector<HTMLElement>('[data-personal-drop]');
    const status = document.querySelector<HTMLElement>('[data-personal-import-status]');
    const offlineStatus = document.querySelector<HTMLElement>('[data-personal-offline-status]');
    const coverUrls = new Set<string>();
    let personalTotal = 0;
    let hostedTotal = 0;
    let offlinePreparationBatch = 0;
    let libraryStateUnavailable = false;

    const formatBytes = (bytes: number) => {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(bytes >= 10 * 1024 * 1024 ? 0 : 1)} MB`;
    };

    function updateTotal() {
      if (libraryStateUnavailable) {
        if (count) count.textContent = 'Local library unavailable';
        return;
      }
      const total = personalTotal + hostedTotal;
      if (count) count.textContent = `${total} book${total === 1 ? '' : 's'}`;
      if (empty) empty.hidden = total !== 0;
    }

    function clearCoverUrls() {
      for (const url of coverUrls) URL.revokeObjectURL(url);
      coverUrls.clear();
    }

    function personalRoute(book: PersonalBookSummary): string {
      return book.format === 'epub'
        ? `${base}/personal/read?id=${encodeURIComponent(book.id)}`
        : `${base}/personal/pdf?id=${encodeURIComponent(book.id)}`;
    }

    async function renderPersonalCard(book: PersonalBookSummary): Promise<HTMLElement> {
      const article = document.createElement('article');
      article.className = 'personal-book';
      article.dataset.personalBook = book.id;

      const cover = document.createElement('div');
      cover.className = 'personal-book__cover';
      if (book.cover) {
        const url = URL.createObjectURL(book.cover);
        coverUrls.add(url);
        const image = document.createElement('img');
        image.src = url;
        image.alt = '';
        cover.append(image);
      } else {
        cover.textContent = book.format.toUpperCase();
        cover.setAttribute('aria-hidden', 'true');
      }

      const body = document.createElement('div');
      body.className = 'personal-book__body';
      const format = document.createElement('p');
      format.className = 'personal-book__format';
      format.textContent = `Personal ${book.format.toUpperCase()}`;
      const title = document.createElement('h3');
      title.className = 'personal-book__title';
      title.textContent = book.title;
      body.append(format, title);

      if (book.creator) {
        const creator = document.createElement('p');
        creator.className = 'personal-book__creator';
        creator.textContent = book.creator;
        body.append(creator);
      }

      const meta = document.createElement('p');
      meta.className = 'personal-book__meta';
      meta.textContent = `${formatBytes(book.size)} · stored on this device`;
      body.append(meta);

      const route = personalRoute(book);
      const continuity = await getReadingContinuity({
        workId: personalReaderWorkId(book),
        edition: 1,
        releaseVersion: personalReaderReleaseVersion(book),
        ...(book.format === 'epub' ? { epubHref: route } : { pdfHref: route }),
      });
      const reading = continuity.primary;
      if (reading?.current) {
        const position = document.createElement('p');
        position.className = 'personal-book__meta';
        position.textContent = readingPositionLabel(reading);
        body.append(position);
      }

      const actions = document.createElement('div');
      actions.className = 'personal-book__actions';
      const open = document.createElement('a');
      open.className = 'personal-book__action';
      open.href = route;
      open.textContent = readingActionLabel(reading);
      if (reading) open.setAttribute('aria-label', `${readingActionLabel(reading)} ${book.title} in ${book.format.toUpperCase()}`);
      const remove = document.createElement('button');
      remove.className = 'personal-book__action personal-book__action--remove';
      remove.type = 'button';
      remove.textContent = 'Remove';
      remove.addEventListener('click', async () => {
        if (!confirm(`Remove “${book.title}” from My Library on this device?`)) return;
        remove.disabled = true;
        try {
          await deletePersonalBook(book.id);
          await deleteReadingActivity(personalReaderWorkId(book)).catch(() => {});
          if (status) { status.dataset.state = 'ok'; status.textContent = `Removed “${book.title}”.`; }
          await renderPersonal();
        } catch (error) {
          remove.disabled = false;
          if (status) { status.dataset.state = 'error'; status.textContent = error instanceof Error ? error.message : 'Unable to remove this book.'; }
        }
      });
      actions.append(open, remove);
      body.append(actions);
      article.append(cover, body);
      return article;
    }

    async function renderPersonal() {
      if (!personalList || !personalSection) return;
      clearCoverUrls();
      const books = await getPersonalBooks();
      const cards = await Promise.all(books.map(renderPersonalCard));
      personalList.replaceChildren(...cards);
      personalTotal = books.length;
      personalSection.hidden = books.length === 0;
      if (personalCount) personalCount.textContent = `${books.length} imported`;
      updateTotal();
    }

    async function renderHosted() {
      const ids = new Set(await getFavoriteWorkIds());
      hostedTotal = 0;
      for (const node of hostedNodes) {
        const show = Boolean(node.dataset.savedWork && ids.has(node.dataset.savedWork));
        node.hidden = !show;
        if (show) hostedTotal++;
      }
      updateTotal();
    }

    async function render() {
      try {
        await Promise.all([renderPersonal(), renderHosted()]);
        libraryStateUnavailable = false;
        if (libraryError) libraryError.hidden = true;
        updateTotal();
      } catch (error) {
        libraryStateUnavailable = true;
        personalTotal = 0;
        hostedTotal = 0;
        if (personalSection) personalSection.hidden = true;
        for (const node of hostedNodes) node.hidden = true;
        if (empty) empty.hidden = true;
        const failure = normalizeLibraryStorageError(error, 'My Library storage');
        if (libraryErrorMessage) {
          libraryErrorMessage.textContent = failure.kind === 'unknown'
            ? 'My Library storage could not be opened. Reload this page; if the problem continues, check browser site-storage settings.'
            : failure.message;
        }
        if (libraryError) libraryError.hidden = false;
        updateTotal();
      }
    }

    function prepareImportedReaders(readerRoutes: string[]) {
      if (!readerRoutes.length) {
        if (offlineStatus) { offlineStatus.dataset.state = ''; offlineStatus.textContent = ''; }
        return;
      }

      const batch = ++offlinePreparationBatch;
      if (offlineStatus) {
        offlineStatus.dataset.state = 'working';
        offlineStatus.textContent = readerRoutes.length === 1
          ? 'Preparing reader for offline use…'
          : `Preparing ${readerRoutes.length} readers for offline use…`;
      }

      void preparePersonalReadersForOffline(readerRoutes).then(() => {
        if (batch !== offlinePreparationBatch || !offlineStatus) return;
        offlineStatus.dataset.state = 'ok';
        offlineStatus.textContent = readerRoutes.length === 1
          ? 'Reader ready for offline use.'
          : `${readerRoutes.length} readers ready for offline use.`;
      }).catch((error) => {
        if (batch !== offlinePreparationBatch || !offlineStatus) return;
        offlineStatus.dataset.state = 'error';
        offlineStatus.textContent = error instanceof Error
          ? `Offline reader setup did not finish: ${error.message}`
          : 'Offline reader setup did not finish.';
      });
    }

    async function importFiles(files: File[]) {
      if (!files.length) return;
      chooseButton?.setAttribute('disabled', '');
      let imported = 0;
      let duplicates = 0;
      const errors: string[] = [];
      const readerRoutes: string[] = [];
      for (const file of files) {
        if (status) { status.dataset.state = 'working'; status.textContent = `Importing ${file.name}…`; }
        try {
          const result = await importPersonalBook(file);
          readerRoutes.push(personalRoute(result.record));
          if (result.duplicate) duplicates++;
          else imported++;
        } catch (error) {
          errors.push(`${file.name}: ${error instanceof Error ? error.message : 'Import failed.'}`);
        }
      }
      chooseButton?.removeAttribute('disabled');
      if (input) input.value = '';
      if (imported > 0) void requestPersonalLibraryPersistence();

      if (status) {
        status.dataset.state = errors.length ? 'error' : 'ok';
        const parts = [
          imported ? `${imported} imported` : '',
          duplicates ? `${duplicates} already in My Library` : '',
          errors.length ? errors.join(' ') : '',
        ].filter(Boolean);
        status.textContent = parts.join(' · ');
      }

      await render();
      prepareImportedReaders(readerRoutes);
    }

    chooseButton?.addEventListener('click', () => input?.click());
    input?.addEventListener('change', () => { void importFiles([...input.files ?? []]); });
    libraryRetry?.addEventListener('click', () => {
      libraryRetry.disabled = true;
      void render().finally(() => { libraryRetry.disabled = false; });
    });

    const hasFiles = (event: DragEvent) => [...(event.dataTransfer?.types ?? [])].includes('Files');
    drop?.addEventListener('dragenter', (event) => { if (hasFiles(event)) { event.preventDefault(); drop.dataset.dragging = 'true'; } });
    drop?.addEventListener('dragover', (event) => { if (hasFiles(event)) { event.preventDefault(); event.dataTransfer!.dropEffect = 'copy'; drop.dataset.dragging = 'true'; } });
    drop?.addEventListener('dragleave', () => { drop.dataset.dragging = 'false'; });
    drop?.addEventListener('drop', (event) => {
      event.preventDefault();
      drop.dataset.dragging = 'false';
      void importFiles([...(event.dataTransfer?.files ?? [])]);
    });
    drop?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); input?.click(); }
    });

    const unsubscribeReading = subscribeUnifiedReadingState(() => { void render(); });
    const unsubscribePersonal = subscribePersonalBooks(() => { void render(); });
    window.addEventListener('pagehide', () => {
      offlinePreparationBatch++;
      unsubscribeReading();
      unsubscribePersonal();
      clearCoverUrls();
    }, { once: true });
    void render();
  </script>
</BaseLayout>