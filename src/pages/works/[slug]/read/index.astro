---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import EpubReaderLayout from '../../../../layouts/EpubReaderLayout.astro';
import ReaderShell from '../../../../components/reader/ReaderShell.astro';
import { getWorks, type ResolvedWork } from '../../../../lib/content/repository';
import { getChaptersForWork } from '../../../../lib/content/chapters';
import {
  localizeReaderPublication,
  readerCanOpen,
  resolveReaderMigration,
} from '../../../../lib/reader/migration';

export async function getStaticPaths() {
  return (await getWorks())
    .filter(readerCanOpen)
    .map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

interface Props { work: ResolvedWork; }
const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const migration = resolveReaderMigration(work);
const publication = migration.publication
  ? localizeReaderPublication(migration.publication, base)
  : undefined;
const chapters = migration.mode === 'legacy-web' ? await getChaptersForWork(work.id) : [];
const first = chapters[0];
const ids = chapters.map((chapter) => chapter.entry.data.id);
const bookHref = `${base}/works/${work.slug}`;
---
{migration.mode === 'native-epub' && publication ? (
  <EpubReaderLayout
    title={`Read ${work.title}`}
    description={work.shortDescription}
    language={work.language}
    noindex
  >
    <div data-reader-publication={JSON.stringify(publication)} hidden></div>
    <ReaderShell
      title={publication.title}
      subtitle={publication.subtitle ?? ''}
      backHref={bookHref}
      loadingMessage={`Opening ${publication.title}…`}
    />
    <script>
      import {
        mountReaderPublicationWithCompatibilityHarness,
        type ReaderCompatibilityHarnessHandle,
        type ReaderPublicationCandidate,
      } from '../../../../lib/reader';

      const publicationNode = document.querySelector<HTMLElement>('[data-reader-publication]');
      const root = document.querySelector<HTMLElement>('[data-reader-shell]');
      let mounted: ReaderCompatibilityHarnessHandle | undefined;
      let pageClosing = false;

      function showLaunchError(message: string) {
        if (!root) return;
        root.dataset.readerStatus = 'error';
        const viewport = root.querySelector<HTMLElement>('[data-reader-viewport]');
        const loading = root.querySelector<HTMLElement>('[data-reader-loading]');
        const error = root.querySelector<HTMLElement>('[data-reader-error]');
        const errorMessage = root.querySelector<HTMLElement>('[data-reader-error-message]');
        viewport?.setAttribute('aria-busy', 'false');
        if (loading) loading.hidden = true;
        if (error) error.hidden = false;
        if (errorMessage) errorMessage.textContent = message;
      }

      if (publicationNode && root) {
        try {
          const raw = publicationNode.dataset.readerPublication;
          if (!raw) throw new Error('Reader publication metadata is missing.');
          const publication = JSON.parse(raw) as ReaderPublicationCandidate;
          void mountReaderPublicationWithCompatibilityHarness(root, publication)
            .then((handle) => {
              if (pageClosing) handle.destroy();
              else mounted = handle;
            })
            .catch((error) => {
              const message = error instanceof Error ? error.message : 'Unable to open this EPUB edition.';
              showLaunchError(message);
            });
        } catch (error) {
          const message = error instanceof Error ? error.message : 'Unable to prepare this EPUB edition.';
          showLaunchError(message);
        }
      }

      window.addEventListener('pagehide', () => {
        pageClosing = true;
        mounted?.destroy();
        mounted = undefined;
      }, { once: true });
    </script>
  </EpubReaderLayout>
) : migration.mode === 'legacy-web' ? (
  <BaseLayout title={`Read ${work.title}`} noindex>
    <div class="page">
      <section class="section">
        <div
          class="empty"
          data-reader-launch
          data-base={base}
          data-work-id={work.id}
          data-work-slug={work.slug}
          data-first-chapter={first?.entry.data.id}
          data-chapter-ids={JSON.stringify(ids)}
        >
          <p class="eyebrow">Reader</p>
          <h2>Opening {work.title}…</h2>
          {first && <p><a href={`${base}/works/${work.slug}/read/${first.entry.data.id}`}>Open the first section</a></p>}
        </div>
      </section>
    </div>
    <script>
      import { getProgress } from '../../../../lib/client/library-db';
      const launch = document.querySelector<HTMLElement>('[data-reader-launch]');
      if (launch?.dataset.workId && launch.dataset.workSlug && launch.dataset.firstChapter) {
        const ids = new Set<string>(JSON.parse(launch.dataset.chapterIds ?? '[]') as string[]);
        const base = launch.dataset.base ?? '/library';
        void getProgress(launch.dataset.workId).then((progress) => {
          const chapter = progress?.chapterId && ids.has(progress.chapterId) ? progress.chapterId : launch.dataset.firstChapter;
          location.replace(`${base}/works/${launch.dataset.workSlug}/read/${chapter}`);
        }).catch(() => location.replace(`${base}/works/${launch.dataset.workSlug}/read/${launch.dataset.firstChapter}`));
      }
    </script>
  </BaseLayout>
) : (
  <BaseLayout title={`Read ${work.title}`} noindex>
    <div class="page">
      <section class="section">
        <div class="empty">
          <p class="eyebrow">Reader unavailable</p>
          <h2>This edition does not currently have a readable web publication.</h2>
          <p><a href={bookHref}>Return to the book page</a></p>
        </div>
      </section>
    </div>
  </BaseLayout>
)}
