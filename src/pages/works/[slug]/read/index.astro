---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import EpubReaderLayout from '../../../../layouts/EpubReaderLayout.astro';
import ReaderShell from '../../../../components/reader/ReaderShell.astro';
import ReaderFormatSwitch from '../../../../components/ReaderFormatSwitch.astro';
import { getWorks, type ResolvedWork } from '../../../../lib/content/repository';
import { getChaptersForWork } from '../../../../lib/content/chapters';
import {
  localizeReaderArtifact,
  localizeReaderPublication,
  readerCanOpen,
  resolveReaderMigration,
} from '../../../../lib/reader/migration';

export async function getStaticPaths() {
  return (await getWorks())
    .filter(readerCanOpen)
    .map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

interface Props { work: ResolvedWork; }
const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const migration = resolveReaderMigration(work);
const publication = migration.publication
  ? localizeReaderPublication(migration.publication, base)
  : undefined;

// Keep the verified Markdown payload available as an explicit compatibility/recovery
// path even when the active release normally opens through EPUB. It is opt-in only.
const legacyChapters = work.webMaterialized ? await getChaptersForWork(work.id) : [];
const first = legacyChapters[0];
const ids = legacyChapters.map((chapter) => chapter.entry.data.id);
const bookHref = `${base}/works/${work.slug}`;
const legacyFallbackHref = first
  ? `${base}/works/${work.slug}/read?legacy=1`
  : undefined;
const pdfFallback = work.release?.artifacts.pdf
  ? localizeReaderArtifact(work.release.artifacts.pdf, base)
  : undefined;
const pdfReaderHref = work.release?.artifacts.pdf
  ? `${base}/works/${work.slug}/pdf`
  : undefined;
---
{migration.mode === 'native-epub' && publication ? (
  <EpubReaderLayout
    title={`Read ${work.title}`}
    description={work.shortDescription}
    language={work.language}
    epubHref={publication.epub.url}
    noindex
  >
    <div data-reader-publication={JSON.stringify(publication)} hidden></div>
    {pdfReaderHref && <ReaderFormatSwitch current="epub" href={pdfReaderHref} />}
    {first && (
      <div
        data-reader-legacy-bridge
        data-base={base}
        data-work-id={work.id}
        data-work-slug={work.slug}
        data-first-chapter={first.entry.data.id}
        data-chapter-ids={JSON.stringify(ids)}
        hidden
      ></div>
    )}
    <ReaderShell
      title={publication.title}
      subtitle={publication.subtitle ?? ''}
      backHref={bookHref}
      loadingMessage={`Opening ${publication.title}…`}
      fallbackWebHref={legacyFallbackHref ?? ''}
      fallbackPdfHref={publication.pdf?.url ?? ''}
      fallbackEpubHref={publication.epub.url}
    />
    <script>
      import { cacheReaderPublicationForOffline } from '../../../../lib/client/pwa';
      import { setReaderFailureState } from '../../../../lib/reader/fallback';
      import type { ReaderFallbackHarnessHandle } from '../../../../lib/reader/fallback-harness';
      import { isLegacyReaderRequested, resolveLegacyResumeHref } from '../../../../lib/reader/legacy-bridge';
      import { ReaderPerformanceController } from '../../../../lib/reader/performance';
      import { recordReadingOpen } from '../../../../lib/reading-activity/client';
      import type { ReaderPublicationCandidate } from '../../../../lib/reader/publication';
      import { mountReaderShell } from '../../../../lib/reader/shell';

      const publicationNode = document.querySelector<HTMLElement>('[data-reader-publication]');
      const legacyBridgeNode = document.querySelector<HTMLElement>('[data-reader-legacy-bridge]');
      const root = document.querySelector<HTMLElement>('[data-reader-shell]');
      const readerPerformance = root ? new ReaderPerformanceController(root) : undefined;
      let mounted: ReaderFallbackHarnessHandle | undefined;
      let bootstrapRetry: ((event: MouseEvent) => void) | undefined;
      let pageClosing = false;

      readerPerformance?.start();

      async function openRequestedLegacyReader(): Promise<boolean> {
        if (!legacyBridgeNode || !isLegacyReaderRequested()) return false;
        const { base, workId, workSlug, firstChapter, chapterIds } = legacyBridgeNode.dataset;
        if (!workId || !workSlug || !firstChapter) return false;
        const href = await resolveLegacyResumeHref({
          base: base ?? '/library',
          workId,
          slug: workSlug,
          firstChapter,
          chapterIds: JSON.parse(chapterIds ?? '[]') as string[],
        });
        location.replace(href);
        return true;
      }

      function showBootstrapFailure(error: unknown) {
        if (!root) return;
        const shell = mountReaderShell(root);
        const failure = setReaderFailureState(shell, error);
        const retry = root.querySelector<HTMLButtonElement>('[data-reader-command="retry"]');
        if (!failure.retryable || !retry) return;
        retry.textContent = 'Reload page';
        bootstrapRetry = (event: MouseEvent) => {
          const origin = event.target instanceof Element ? event.target : null;
          const button = origin?.closest<HTMLElement>('[data-reader-command="retry"]');
          if (!button || !root.contains(button)) return;
          event.preventDefault();
          location.reload();
        };
        root.addEventListener('click', bootstrapRetry);
      }

      async function bootNativeReader(publication: ReaderPublicationCandidate) {
        if (!root || pageClosing) return;
        try {
          readerPerformance?.markModuleLoading();
          const { mountReaderPublicationWithFallbackHarness } = await import('../../../../lib/reader/fallback-harness');
          if (pageClosing) return;
          readerPerformance?.markOpening();
          const handle = await mountReaderPublicationWithFallbackHarness(root, publication);
          if (pageClosing) handle.destroy();
          else {
            mounted = handle;
            void recordReadingOpen({
              workId: publication.workId,
              edition: publication.edition,
              releaseVersion: publication.version,
              format: 'epub',
              source: 'hosted',
            }).catch(() => {});
            if (handle.reader) void cacheReaderPublicationForOffline(publication.epub.url);
          }
        } catch (error) {
          showBootstrapFailure(error);
        }
      }

      if (publicationNode && root) {
        try {
          const raw = publicationNode.dataset.readerPublication;
          if (!raw) throw new Error('Reader publication metadata is missing.');
          const publication = JSON.parse(raw) as ReaderPublicationCandidate;
          requestAnimationFrame(() => {
            void openRequestedLegacyReader().then((redirected) => {
              if (redirected || pageClosing) return;
              readerPerformance?.markShellPainted();
              void bootNativeReader(publication);
            }).catch(() => {
              readerPerformance?.markShellPainted();
              void bootNativeReader(publication);
            });
          });
        } catch (error) {
          showBootstrapFailure(error);
        }
      }

      window.addEventListener('pagehide', () => {
        pageClosing = true;
        if (root && bootstrapRetry) root.removeEventListener('click', bootstrapRetry);
        bootstrapRetry = undefined;
        mounted?.destroy();
        mounted = undefined;
        readerPerformance?.destroy();
      }, { once: true });
    </script>
  </EpubReaderLayout>
) : migration.mode === 'legacy-web' && first ? (
  <BaseLayout title={`Read ${work.title}`} noindex>
    <div class="page">
      <section class="section">
        <div
          class="empty"
          data-reader-launch
          data-base={base}
          data-work-id={work.id}
          data-work-slug={work.slug}
          data-first-chapter={first.entry.data.id}
          data-chapter-ids={JSON.stringify(ids)}
        >
          <p class="eyebrow">Reader</p>
          <h2>Opening {work.title}…</h2>
          <p><a href={`${base}/works/${work.slug}/read/${first.entry.data.id}`}>Open the first section</a></p>
        </div>
      </section>
    </div>
    <script>
      import { resolveLegacyResumeHref } from '../../../../lib/reader/legacy-bridge';
      const launch = document.querySelector<HTMLElement>('[data-reader-launch]');
      if (launch?.dataset.workId && launch.dataset.workSlug && launch.dataset.firstChapter) {
        void resolveLegacyResumeHref({
          base: launch.dataset.base ?? '/library',
          workId: launch.dataset.workId,
          slug: launch.dataset.workSlug,
          firstChapter: launch.dataset.firstChapter,
          chapterIds: JSON.parse(launch.dataset.chapterIds ?? '[]') as string[],
        }).then((href) => location.replace(href));
      }
    </script>
  </BaseLayout>
) : (
  <BaseLayout title={`Read ${work.title}`} noindex>
    <div class="page">
      <section class="section">
        <div class="empty">
          <p class="eyebrow">Reader unavailable</p>
          <h2>This edition does not currently have a usable web reading path.</h2>
          <p>The Library did not silently switch this title to a different edition or format.</p>
          <div class="actions">
            {pdfReaderHref && <a class="button" href={pdfReaderHref}>Open PDF reader</a>}
            {pdfFallback && <a class="button secondary" href={pdfFallback.url}>Open original PDF</a>}
            <a class="button secondary" href={bookHref}>Return to the book page</a>
          </div>
        </div>
      </section>
    </div>
  </BaseLayout>
)}