---
import PdfReaderLayout from '../../../layouts/PdfReaderLayout.astro';
import PdfReaderShell from '../../../components/PdfReaderShell.astro';
import ReaderFormatSwitch from '../../../components/ReaderFormatSwitch.astro';
import { getWorks, type ResolvedWork } from '../../../lib/content/repository';
import { localizeReaderArtifact } from '../../../lib/reader/migration';
import type { PdfCanonicalCandidate } from '../../../lib/pdf-reader/canonical';

export async function getStaticPaths() {
  return (await getWorks())
    .filter((work) => Boolean(work.release?.artifacts.pdf))
    .map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

interface Props { work: ResolvedWork; }
const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const release = work.release;
const pdf = release?.artifacts.pdf;
if (!release || !pdf) throw new Error(`PDF release missing for ${work.id}`);
const localizedPdf = localizeReaderArtifact({ ...pdf }, base);
const backHref = `${base}/works/${work.slug}`;
const epubReaderHref = release.artifacts.epub ? `${base}/works/${work.slug}/read` : undefined;
const candidate: PdfCanonicalCandidate = {
  source: localizedPdf.url,
  identity: {
    workId: work.id,
    edition: release.edition,
    releaseVersion: release.version,
  },
  title: work.title,
  language: work.language,
  fallbackUrl: localizedPdf.url,
  backHref,
};
const metadata = `PDF · edition ${release.edition} · ${Math.max(1, Math.round(pdf.sizeBytes / 1024 / 1024 * 10) / 10)} MB`;
---
<PdfReaderLayout
  title={`${work.title} — PDF`}
  description={`Integrated PDF edition of ${work.title}`}
  language={work.language}
  pdfHref={localizedPdf.url}
  noindex
>
  {epubReaderHref && <ReaderFormatSwitch current="pdf" href={epubReaderHref} />}
  <PdfReaderShell
    title={work.title}
    backHref={backHref}
    backLabel={`Back to ${work.title}`}
    fallbackHref={localizedPdf.url}
    metadata={metadata}
  />
  <div hidden data-pdf-candidate={JSON.stringify(candidate)}></div>
  <script>
    import { mountPdfReader, type PdfReaderHandle } from '../../../lib/pdf-reader';
    import type { PdfCanonicalCandidate } from '../../../lib/pdf-reader/canonical';
    import { recordReadingOpen } from '../../../lib/reading-activity/client';

    const root = document.querySelector<HTMLElement>('[data-pdf-reader-root]');
    const encoded = document.querySelector<HTMLElement>('[data-pdf-candidate]')?.dataset.pdfCandidate;
    let mounted: PdfReaderHandle | undefined;
    let reload: (() => void) | undefined;

    function bootstrapFailure(message: string) {
      if (!root) return;
      root.dataset.pdfReaderState = 'error';
      root.removeAttribute('aria-busy');
      const error = root.querySelector<HTMLElement>('[data-pdf-error]');
      const errorMessage = root.querySelector<HTMLElement>('[data-pdf-error-message]');
      const status = root.querySelector<HTMLElement>('[data-pdf-status]');
      const retry = root.querySelector<HTMLButtonElement>('[data-pdf-retry]');
      if (errorMessage) errorMessage.textContent = message;
      if (error) error.hidden = false;
      if (status) status.hidden = true;
      if (retry) {
        reload = () => location.reload();
        retry.addEventListener('click', reload, { once: true });
      }
    }

    async function boot() {
      if (!root || !encoded) return bootstrapFailure('The PDF reader could not read its publication identity.');
      try {
        const candidate = JSON.parse(encoded) as PdfCanonicalCandidate;
        mounted = await mountPdfReader(root, candidate);
        void recordReadingOpen({
          ...candidate.identity,
          format: 'pdf',
          source: 'hosted',
        }).catch(() => {});
      } catch (error) {
        bootstrapFailure(error instanceof Error ? error.message : 'Unable to start the PDF reader.');
      }
    }

    requestAnimationFrame(() => void boot());
    window.addEventListener('pagehide', () => {
      const retry = root?.querySelector<HTMLButtonElement>('[data-pdf-retry]');
      if (retry && reload) retry.removeEventListener('click', reload);
      void mounted?.destroy();
      mounted = undefined;
    }, { once: true });
  </script>
</PdfReaderLayout>
