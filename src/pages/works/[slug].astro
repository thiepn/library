---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorks, type ResolvedWork } from '../../lib/content/repository';
import { taxonomyLabel } from '../../lib/content/taxonomy';
export async function getStaticPaths() {
  return (await getWorks()).map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
interface Props { work: ResolvedWork; }
const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const coverUrl = /^https?:\/\//i.test(work.cover.src)
  ? work.cover.src
  : `${base}${work.cover.src.startsWith('/') ? work.cover.src : `/${work.cover.src}`}`;
const pdf = work.release?.artifacts.pdf;
const epub = work.release?.artifacts.epub;
const webStatus = work.webMaterialized ? 'available' : work.id === 'ai-for-the-kingdom' ? `restoring ${work.chapterCount}/57` : 'restoring';
---
<BaseLayout title={work.title} description={work.shortDescription}>
  <article class="page" data-pagefind-body data-pagefind-meta={`work_id:${work.id}`}>
    <section class="work-hero">
      <div class="publication-cover-frame">
        <img class="publication-cover" src={coverUrl} alt={work.cover.alt} decoding="async" />
      </div>
      <div>
        <p class="eyebrow">{work.publication.editionLabel}</p>
        <h1 data-pagefind-weight="10">{work.title}</h1>
        {work.subtitle && <p class="work-deck">{work.subtitle}</p>}
        <p class="work-description">{work.description}</p>
        <div class="work-actions">
          {work.webMaterialized && <a class="primary-action" href={`${base}/works/${work.slug}/read`}>Start reading</a>}
          {pdf && <a class="secondary-action" href={`${base}/works/${work.slug}/pdf`}>Read PDF</a>}
          {epub && <a class="secondary-action" href={epub.url}>Download EPUB</a>}
          <button class="secondary-action" type="button" data-save-work={work.id}>Save to my library</button>
        </div>
        <div class="format-status" aria-label="Edition status">
          <span>Web · {webStatus}</span>
          <span>PDF · {pdf ? 'available' : 'restoring'}</span>
          <span>EPUB · {epub ? 'available' : 'restoring'}</span>
        </div>
        {(!work.webMaterialized || !work.releaseMaterialized) && <p class="recovery-note"><strong>Edition restoration:</strong> validated publication metadata is present, but reader and binary controls activate only after their exact payloads pass the materialization gates. Partial or unverified files are never exposed as a release.</p>}
      </div>
    </section>
    <dl class="meta-grid">
      <div><dt>Release</dt><dd>{work.publication.version}</dd></div>
      <div><dt>Language</dt><dd>{work.language}</dd></div>
      <div><dt>Subjects</dt><dd class="taxonomy-inline">{work.classification.subjects.map((subject, index) => <><a href={`${base}/subjects/${subject}`}>{taxonomyLabel(subject)}</a>{index < work.classification.subjects.length - 1 && <span>, </span>}</>)}</dd></div>
      <div><dt>Collections</dt><dd class="taxonomy-inline">{work.classification.collections.length ? work.classification.collections.map((collection, index) => <><a href={`${base}/collections/${collection}`}>{taxonomyLabel(collection)}</a>{index < work.classification.collections.length - 1 && <span>, </span>}</>) : '—'}</dd></div>
      <div><dt>Rights</dt><dd>{work.rights.status}</dd></div>
    </dl>
  </article>
  <script>
    import { isFavorite, toggleFavorite } from '../../lib/client/library-db';
    const control = document.querySelector<HTMLButtonElement>('[data-save-work]');
    const workId = control?.dataset.saveWork;
    async function renderSavedState() {
      if (!control || !workId) return;
      const saved = await isFavorite(workId);
      control.textContent = saved ? 'Remove from my library' : 'Save to my library';
      control.setAttribute('aria-pressed', String(saved));
    }
    control?.addEventListener('click', async () => {
      if (!control || !workId) return;
      control.disabled = true;
      try { await toggleFavorite(workId); await renderSavedState(); }
      finally { control.disabled = false; }
    });
    void renderSavedState();
  </script>
</BaseLayout>
