---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWorks } from '../lib/content/repository';
import { taxonomyLabel } from '../lib/content/taxonomy';
import '../styles/library-home.css';

const works = await getWorks();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catalog = works.map((work) => {
  const coverUrl = /^https?:\/\//i.test(work.cover.src)
    ? work.cover.src
    : `${base}${work.cover.src.startsWith('/') ? work.cover.src : `/${work.cover.src}`}`;
  const release = work.release;
  const pdf = release?.artifacts.pdf;
  const epub = release?.artifacts.epub;
  const readHref = work.webMaterialized ? `${base}/works/${work.slug}/read` : undefined;
  const pdfHref = pdf ? `${base}/works/${work.slug}/pdf` : undefined;
  const formats = [
    work.webMaterialized ? 'Reader' : null,
    epub ? 'EPUB' : null,
    pdf ? 'PDF' : null,
  ].filter((value): value is string => Boolean(value));
  const primary = readHref
    ? { href: readHref, label: 'Start reading', kind: 'web' as const }
    : epub
      ? { href: epub.url, label: 'Download EPUB', kind: 'epub' as const }
      : pdfHref
        ? { href: pdfHref, label: 'Read PDF', kind: 'pdf' as const }
        : undefined;
  return { work, coverUrl, release, readHref, pdfHref, epub, formats, primary };
});
---
<BaseLayout title="Library" description="A personal digital library for reading books online, offline, in EPUB, or in PDF.">
  <div class="page library-home" data-library-home>
    <header class="library-intro">
      <div class="library-intro-copy">
        <p class="eyebrow">Your reading library</p>
        <h1>Books</h1>
        <p>{works.length} book{works.length === 1 ? '' : 's'} available. Pick up where you left off, browse your library, or find something new to read.</p>
      </div>
      <form class="catalog-search" action={`${base}/search`} method="get" role="search">
        <label class="sr-only" for="home-library-search">Search the Library</label>
        <input id="home-library-search" type="search" name="q" placeholder="Search books, chapters, or topics" autocomplete="off" />
        <button type="submit">Search</button>
      </form>
    </header>

    {catalog.length > 0 && (
      <section class="resume-section" data-continue-section hidden aria-labelledby="resume-heading">
        <div class="compact-heading">
          <div><p class="eyebrow">Your reading</p><h2 id="resume-heading">Continue reading</h2></div>
          <a href={`${base}/saved`}>My Library</a>
        </div>
        <div class="continue-list compact-continue" data-continue-list>
          {catalog.map(({ work, release, readHref }) => (
            <a
              class="continue-item"
              href={readHref ?? `${base}/works/${work.slug}`}
              data-continue-work={work.id}
              data-edition={work.publication.edition}
              data-release-version={release?.version ?? ''}
              data-web-readable={readHref ? 'true' : 'false'}
              hidden
            >
              <span><strong>{work.title}</strong>{work.subtitle && <small>{work.subtitle}</small>}</span>
              <span class="continue-item__status">
                <span data-continue-context>Reading progress</span>
                <span class="micro" data-continue-progress>Resume</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    {catalog.length > 0 && (
      <section class="resume-section" data-recent-section hidden aria-labelledby="recent-heading">
        <div class="compact-heading">
          <div><p class="eyebrow">Recent activity</p><h2 id="recent-heading">Recently read</h2></div>
          <a href={`${base}/saved`}>My Library</a>
        </div>
        <div class="continue-list compact-continue" data-recent-list>
          {catalog.map(({ work }) => (
            <a class="continue-item" href={`${base}/works/${work.slug}`} data-recent-work={work.id} hidden>
              <span><strong>{work.title}</strong>{work.subtitle && <small>{work.subtitle}</small>}</span>
              <span class="continue-item__status">
                <span data-recent-context>Recent reading</span>
                <span class="micro" data-recent-detail>Recently opened</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="catalog-section" id="books" aria-labelledby="catalog-heading">
      <div class="catalog-toolbar">
        <div>
          <p class="eyebrow">Library</p>
          <h2 id="catalog-heading">All books</h2>
        </div>
        <nav class="catalog-links" aria-label="Library navigation">
          <a href={`${base}/saved`}>My Library</a>
          <a href={`${base}/subjects`}>Subjects</a>
          <a href={`${base}/collections`}>Collections</a>
          <a href={`${base}/search`}>Search</a>
        </nav>
      </div>

      {catalog.length ? (
        <div class="catalog-grid">
          {catalog.map(({ work, coverUrl, release, readHref, formats, primary }) => (
            <article
              class="catalog-book"
              data-pagefind-ignore="all"
              data-catalog-work={work.id}
              data-edition={work.publication.edition}
              data-release-version={release?.version ?? ''}
              data-web-readable={readHref ? 'true' : 'false'}
              data-saved="false"
            >
              <a class="catalog-cover" href={`${base}/works/${work.slug}`} aria-label={`Open ${work.title}`}>
                <img src={coverUrl} alt={work.cover.alt} loading="lazy" decoding="async" />
              </a>
              <div class="catalog-copy">
                <div class="catalog-kicker">
                  <div class="catalog-subjects">
                    {work.classification.subjects.slice(0, 2).map((subject, index) => (
                      <>
                        <a href={`${base}/subjects/${subject}`}>{taxonomyLabel(subject)}</a>
                        {index < Math.min(2, work.classification.subjects.length) - 1 && <span>·</span>}
                      </>
                    ))}
                  </div>
                  <span class="catalog-saved-badge" data-saved-badge hidden>In My Library</span>
                </div>
                <h3><a href={`${base}/works/${work.slug}`}>{work.title}</a></h3>
                {work.subtitle && <p class="catalog-subtitle">{work.subtitle}</p>}
                <p class="catalog-description">{work.shortDescription}</p>
                <p class="micro catalog-activity" data-catalog-activity hidden></p>

                <div class="catalog-progress" data-catalog-progress hidden aria-live="polite">
                  <div class="catalog-progress__copy">
                    <span data-catalog-progress-context>Reading progress</span>
                    <strong data-catalog-progress-label>0%</strong>
                  </div>
                  <div class="catalog-progress__track" aria-hidden="true">
                    <span data-catalog-progress-fill></span>
                    <i data-catalog-progress-furthest></i>
                  </div>
                </div>

                <div class="catalog-meta">
                  <div class="catalog-format-list" aria-label="Available reading formats">
                    {formats.length
                      ? formats.map((format) => <span>{format}</span>)
                      : <span>Book details</span>}
                  </div>
                </div>

                <div class="catalog-actions">
                  {primary && (
                    <a
                      class="catalog-primary"
                      href={primary.href}
                      data-catalog-reader-cta={primary.kind === 'web' ? '' : undefined}
                    >
                      {primary.label}
                    </a>
                  )}
                  <a href={`${base}/works/${work.slug}`}>Book details</a>
                  <button type="button" data-save-work={work.id} aria-pressed="false">Add to My Library</button>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty compact-empty"><h2>No books yet.</h2><p>Your Library does not contain any books yet.</p></div>
      )}
    </section>
  </div>

  <script>
    import { getFavoriteWorkIds, subscribeLibraryState, toggleFavorite } from '../lib/client/library-db';

    const root = document.querySelector<HTMLElement>('[data-library-home]');
    const cards = [...(root?.querySelectorAll<HTMLElement>('[data-catalog-work]') ?? [])];

    async function renderCards() {
      const favorites = new Set(await getFavoriteWorkIds().catch(() => []));
      for (const card of cards) {
        const workId = card.dataset.catalogWork;
        if (!workId) continue;
        const saved = favorites.has(workId);
        card.dataset.saved = String(saved);
        const badge = card.querySelector<HTMLElement>('[data-saved-badge]');
        if (badge) badge.hidden = !saved;
        const saveButton = card.querySelector<HTMLButtonElement>('[data-save-work]');
        if (saveButton) {
          saveButton.textContent = saved ? 'In My Library' : 'Add to My Library';
          saveButton.setAttribute('aria-pressed', String(saved));
        }
      }
    }

    root?.addEventListener('click', (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-save-work]');
      const workId = button?.dataset.saveWork;
      if (!button || !workId) return;
      event.preventDefault();
      button.disabled = true;
      void toggleFavorite(workId)
        .then(() => renderCards())
        .finally(() => { button.disabled = false; });
    });

    const unsubscribe = subscribeLibraryState(() => { void renderCards(); });
    window.addEventListener('pagehide', unsubscribe, { once: true });
    void renderCards();
  </script>
</BaseLayout>
