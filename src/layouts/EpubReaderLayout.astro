---
import '../styles/reader-shell.css';
import '../styles/reader-modes.css';
import '../styles/reader-themes.css';
import '../styles/reader-search.css';
import '../styles/reader-bookmarks.css';
import '../styles/reader-annotations.css';
import '../styles/reader-mobile.css';
import '../styles/reader-desktop.css';
import '../styles/reader-accessibility.css';

interface Props {
  title?: string;
  description?: string;
  language?: string;
  epubHref?: string;
  noindex?: boolean;
}

const {
  title = 'Reader',
  description = 'Native EPUB reading experience in Thiepn Library.',
  language = 'en',
  epubHref,
  noindex = true,
} = Astro.props;
const pageTitle = `${title} — Thiepn Library`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path = '') => `${base}${path}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---
<!doctype html>
<html lang={language} data-reader-document data-reader-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbfbfa" />
    <meta name="application-name" content="Thiepn Library" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Thiepn Library" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    {epubHref && (
      <link
        rel="preload"
        href={epubHref}
        as="fetch"
        type="application/epub+zip"
        crossorigin="anonymous"
        fetchpriority="high"
      />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400;7..72,600&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body class="reader-document" data-reader-theme="light">
    <a class="reader-skip-link" href="#reader-viewport">Skip to book</a>
    <slot />
    <script>
      import { registerLibraryPwa } from '../lib/client/pwa';
      void registerLibraryPwa();
    </script>
  </body>
</html>
