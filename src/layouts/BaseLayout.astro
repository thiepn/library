---
import '../styles/global.css';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'Thiepn Library', description = 'A personal digital library for reading books with saved progress, highlights, notes, and offline support.', noindex = false } = Astro.props;
const pageTitle = title === 'Thiepn Library' ? title : `${title} — Thiepn Library`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path = '') => `${base}${path}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data: blob: https://media.library.thiepn.dev",
  "media-src 'self' data: blob: https://media.library.thiepn.dev",
  "connect-src 'self' https://media.library.thiepn.dev",
  "frame-src 'self' blob:",
  "worker-src 'self' blob:",
  "form-action 'self'",
  "manifest-src 'self'",
  // Pages production is HTTPS already; WebKit upgrades localhost HTTP module loads and breaks acceptance if this directive is present.
].join('; ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="referrer" content="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F3EE" />
    <meta name="application-name" content="Thiepn Library" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Thiepn Library" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Thiepn Library" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400;7..72,600&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={href()} aria-label="Thiepn Library home"><span>THIEPN</span><span>LIBRARY</span></a>
      <nav aria-label="Primary">
        <a href={href()}>Library</a>
        <a href={href('/saved')}>My Library</a>
        <a href={href('/downloads')}>Offline</a>
        <a href={href('/search')}>Search</a>
        <a href={href('/about')}>About</a>
      </nav>
      <button class="appearance-toggle" type="button" data-appearance-toggle aria-label="Change appearance">Theme</button>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <span>THIEPN / LIBRARY</span>
      <nav aria-label="Footer"><a href={href('/privacy')}>Privacy</a><a href={href('/security')}>Security</a><a href={href('/support')}>Support</a><a href={href('/annotations')}>Annotations</a><a href={href('/backup')}>Backup</a><a href={href('/about')}>About</a></nav>
      <span>Local-first reading</span>
    </footer>
    <script>
      import { registerLibraryPwa } from '../lib/client/pwa';
      void registerLibraryPwa();
    </script>
    <script>
      import { normalizeEpubFirstReaderEntries } from '../lib/reader-entry/epub-first-dom';
      import { mountUnifiedReaderEntry } from '../lib/reader-entry/dom';
      normalizeEpubFirstReaderEntries();
      const unmountUnifiedReaderEntry = mountUnifiedReaderEntry();
      window.addEventListener('pagehide', unmountUnifiedReaderEntry, { once: true });
    </script>
    <script>
      import { mountReadingActivityLibraryState } from '../lib/reading-activity/library-dom';
      const unmountReadingActivityLibraryState = mountReadingActivityLibraryState();
      window.addEventListener('pagehide', unmountReadingActivityLibraryState, { once: true });
    </script>
    <script>
      type Appearance = 'system' | 'light' | 'dark';
      interface LibrarySettings { appearance?: Appearance; [key: string]: unknown; }
      const key = 'thiepn.library.settings.v1';
      const root = document.documentElement;
      const button = document.querySelector<HTMLElement>('[data-appearance-toggle]');
      const valid = new Set<Appearance>(['system', 'light', 'dark']);
      const readSettings = (): LibrarySettings => {
        try { return JSON.parse(localStorage.getItem(key) ?? '{}') as LibrarySettings; }
        catch { return {}; }
      };
      const read = (): Appearance => {
        const value = readSettings().appearance;
        return value && valid.has(value) ? value : 'system';
      };
      const apply = (appearance: Appearance) => {
        if (appearance === 'system') delete root.dataset.theme;
        else root.dataset.theme = appearance;
        if (button) button.textContent = appearance === 'system' ? 'Theme' : `${appearance.charAt(0).toUpperCase()}${appearance.slice(1)}`;
      };
      let appearance: Appearance = read();
      apply(appearance);
      button?.addEventListener('click', () => {
        appearance = appearance === 'system' ? 'light' : appearance === 'light' ? 'dark' : 'system';
        localStorage.setItem(key, JSON.stringify({ ...readSettings(), appearance }));
        apply(appearance);
      });
    </script>
  </body>
</html>