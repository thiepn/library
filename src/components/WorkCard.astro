---
import type { ResolvedWork } from '../lib/content/repository';
import { taxonomyLabel } from '../lib/content/taxonomy';
interface Props { work: ResolvedWork; index?: number; }
const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const workUrl = `${base}/works/${work.slug}`;
const coverUrl = /^https?:\/\//i.test(work.cover.src)
  ? work.cover.src
  : `${base}${work.cover.src.startsWith('/') ? work.cover.src : `/${work.cover.src}`}`;
---
<article class="work-card" data-pagefind-ignore="all">
  <a class="publication-cover-link" href={workUrl} aria-label={`Open ${work.title}`}>
    <img class="publication-cover" src={coverUrl} alt={work.cover.alt} loading="lazy" decoding="async" />
  </a>
  <div class="work-card-copy">
    <p class="eyebrow taxonomy-inline">{work.classification.subjects.slice(0, 3).map((subject, subjectIndex) => <><a href={`${base}/subjects/${subject}`}>{taxonomyLabel(subject)}</a>{subjectIndex < Math.min(3, work.classification.subjects.length) - 1 && <span> · </span>}</>)}</p>
    <h2><a href={workUrl}>{work.title}</a></h2>
    {work.subtitle && <p class="work-subtitle">{work.subtitle}</p>}
    <p class="muted">{work.shortDescription}</p>
    <p class="micro">{work.publication.editionLabel} · {work.publication.version}</p>
  </div>
</article>

<style>
  .publication-cover-link {
    width: min(280px, 100%);
    display: block;
    align-self: start;
    background: #0c0d0f;
    border: 1px solid color-mix(in srgb, var(--strong-rule) 55%, transparent);
    border-radius: 2px;
    box-shadow: 8px 9px 0 color-mix(in srgb, var(--strong-rule) 35%, transparent);
    overflow: hidden;
    text-decoration: none;
  }
  .publication-cover {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 800px) {
    .publication-cover-link { width: min(260px, 72vw); }
  }
  @media (max-width: 440px) {
    .publication-cover-link { width: 190px; }
  }
</style>
