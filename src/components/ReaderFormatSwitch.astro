---
import '../styles/reader-format-switch.css';

interface Props {
  current: 'epub' | 'pdf';
  href: string;
}

const { current, href } = Astro.props;
const alternate = current === 'epub' ? 'PDF' : 'EPUB';
---
<nav class="reader-format-switch" data-reader-format-switch aria-label="Reading format">
  <span aria-current="page">{current.toUpperCase()}</span>
  <a href={href} aria-label={`Switch to ${alternate}`}>{alternate}</a>
</nav>
