{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thiepn-library",
  "compatibility_date": "2026-08-23",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "thiepn.dev/library*",
      "zone_name": "thiepn.dev"
    }
  ]
}
