/library/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  Content-Security-Policy: default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; object-src 'none'; manifest-src 'self'; img-src 'self' data: blob: https://media.library.thiepn.dev; media-src 'self' blob: https://media.library.thiepn.dev; font-src 'self' https://fonts.gstatic.com; style-src 'self' https://fonts.googleapis.com; script-src 'self'; connect-src 'self' https://media.library.thiepn.dev; worker-src 'self' blob:; upgrade-insecure-requests

/library/service-worker.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /library/

/library/manifest.webmanifest
  Cache-Control: no-cache

/library/_astro/*
  Cache-Control: public, max-age=31536000, immutable
